# Frontend environment variables (Vite). Copy this file to `.env` and fill in real values.
# Only variables prefixed with VITE_ are exposed to the browser.

# Backend API base URL (defaults to http://localhost:5000/api when unset).
VITE_API_BASE_URL=http://localhost:5000/api

# NOTE: Google Maps is NO LONGER configured here.
# The Google Maps API key is configured at runtime by a Super Admin under
#   System Settings → Third Party Integrations → Google Maps
# (or, for headless installs, via the backend GOOGLE_MAPS_API_KEY env var).
# See docs/GOOGLE_MAPS_SETUP.md.
