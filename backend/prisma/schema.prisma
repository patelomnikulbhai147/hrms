  attachments         String?   @db.Text // JSON array of {name,data,mimeType}
  // Workflow: Draft â†’ Pending Approval â†’ Approved â†’ (Rejected) â†’ Disbursed â†’
  // Running â†’ Completed â†’ Closed
  status              String    @default("Draft")
  rejectionReason     String?
