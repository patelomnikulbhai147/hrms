model LeaveBalance {
  id                  Int      @id @default(autoincrement())
  companyId           Int
  employeeId          Int
  year                Int      @default(2026)
  clBalance           Float    @default(0)
  plBalance           Float    @default(0)
  slBalance           Float    @default(0)
  clUsed              Float    @default(0)
  plUsed              Float    @default(0)
  slUsed              Float    @default(0)
  carryForward        Float    @default(0)
  accruedThroughMonth Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year])
}

model AttendanceSummary {
  id          Int      @id @default(autoincrement())
  companyId   Int
  employeeId  Int
  month       String
  year        Int      @default(2026)
  presentDays Float    @default(0)
  absentDays  Float    @default(0)
  cl          Float    @default(0)
  pl          Float    @default(0)
  sl          Float    @default(0)
  lwp         Float    @default(0)
  halfDays    Float    @default(0)
  otHours     Float    @default(0)
  shift       String?
  payableDays Float    @default(0)
  // Attendance snapshot fields — the single source of truth the Payroll engine
  // reads. workingDays = daysInMonth − weeklyOff − holiday (payroll's proration
  // denominator). weeklyOff/holiday are kept explicit so the Salary Worksheet and
  // Salary Slip can show them and match the Attendance Synchronization page exactly.
  workingDays      Float   @default(0)
  weeklyOffDays    Float   @default(0)
  holidayDays      Float   @default(0)
  attendanceStatus String? // Complete | Partial | Missing (recorded days vs working days)
  attendanceSource String? // e.g. Biometric / Manual / System Computed
  syncedAt         DateTime? // set on "Confirm & Write to Payroll"
  locked      Boolean  @default(false)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
}

model Document {
  id               Int      @id @default(autoincrement())
  companyId        Int
  branchId         Int? // branch the document is scoped to (optional)
  name             String
  type             String
  employeeId       Int?
  employeeName     String?
  uploadedBy       String
  uploadedOn       String
  size             String
  url              String?  @db.Text // external link (Google Drive / OneDrive / Dropbox / direct PDF)
  fileData         String?  @db.LongText // base64-encoded uploaded file (device / drag-drop / camera)
  mimeType         String? // MIME type of fileData, drives the preview viewer
  documentNumber   String? // e.g. Aadhaar / PAN / passport number (optional)
  category         String? // Company Profile grouping: Legal / Tax / Labour / Business / Financial / Insurance / HR / Other
  issuingAuthority String? // who issued the document (Company Profile docs)
  issueDate        String? // optional issue date (ISO yyyy-mm-dd)
  expiryDate       String? // optional expiry date — drives "Expiring Soon" / "Expired"
  renewalDate      String? // optional next-renewal date
  remarks          String?  @db.Text // upload / verification remarks
  verifiedBy       String? // audit: who verified/rejected
  verifiedOn       String? // audit: when verified/rejected
  editedBy         String? // audit: who last edited details
  editedOn         String? // audit: when last edited
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  status           String   @default("Pending")
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// Company Profile → Contacts & Management. One row per key person (Founder, CEO,
// Managing Director, Director, Company Secretary, HR Head, Finance Head,
// Compliance Officer, Authorized Signatory, …). Photo & signature are base64.
model CompanyContact {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String
  designation String?
  roleKey     String? // canonical slot for templates (e.g. "authorizedSignatory")
  mobile      String?
  email       String?
  photo       String?  @db.LongText
  signature   String?  @db.LongText
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// Company Profile → Basic Information → Owner(s) / Director(s). Additive, isolated
// table (kept separate from CompanyContact key-personnel). Exactly one row per
// company may be the primary contact (enforced in the controller). The primary
// owner feeds the {{owner_*}} document/report placeholders.
model CompanyOwner {
  id                  Int      @id @default(autoincrement())
  companyId           Int
  name                String
  designation         String?
  mobile              String?
  email               String?
  ownershipPercentage String?
  joiningDate         String?
  notes               String?  @db.Text
  isPrimary           Boolean  @default(false)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// Company Profile → Statutory & Compliance. One row per compliance item the
// company tracks (PF/ESI/GST/Labour License/FSSAI/insurance/…). The catalog +
// mandatory grouping lives on the frontend; registration numbers are prefilled
// from the Company record (no duplicate entry). The certificate file + prior
// versions are stored inline (base64). Status is computed from the dates.
model ComplianceRecord {
  id                 Int      @id @default(autoincrement())
  companyId          Int
  category           String // Labour / Payroll / Tax / Business / Industry / Insurance
  complianceKey      String // catalog key, e.g. "pf_registration"
  name               String
  mandatory          Boolean  @default(false)
  registrationNumber String?
  certificateNumber  String?
  issuingAuthority   String?
  issueDate          String?
  expiryDate         String?
  renewalDate        String?
  status             String? // optional manual override; display status computed from dates
  reminderDays       Int?     @default(30)
  assignedTo         String?
  uploadedBy         String? // who uploaded/created the record (preserved on migration from Document)
  remarks            String?  @db.Text
  fileData           String?  @db.LongText
  mimeType           String?
  fileName           String?
  fileSize           String?
  versionHistory     String?  @db.LongText // JSON: prior file versions [{fileName,fileSize,mimeType,uploadedOn,uploadedBy,fileData}]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model PaymentRecord {
  id           Int      @id @default(autoincrement())
  companyId    Int
  companyName  String
  planName     String
  amount       Float
  billingCycle String
  status       String
  date         String
  invoiceUrl   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int      @id @default(autoincrement())
  companyId Int?
  userId    Int? // target user (null = company/branch-wide)
  branchId  Int?
  type      String
  title     String?
  message   String
  timestamp String
  read      Boolean  @default(false)
  status    String   @default("unread") // unread / read
  priority  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Broadcast provenance (all nullable; only set on type = "broadcast") ─────
  // Who sent it — kept as a denormalised snapshot, not a relation, so the bell
  // can render "Sent by Company Head" without a join, and so the record still
  // reads correctly after the sender is renamed or offboarded.
  senderId       Int?
  senderName     String?
  senderRole     String?
  senderBranchId Int?
  // What was targeted. This is the AUDIT of the dispatch, kept per delivered row
  // so a cross-branch delivery would be provable after the fact rather than
  // having to be inferred from who happens to hold the row.
  targetType       String? // all | branch | role | department | employee
  targetBranchId   Int?
  targetBranchName String?
  targetDepartment String?
  targetRole       String?

  @@index([userId])
  @@index([companyId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  module    String
  targetId  String
  details   String?  @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model SubscriptionPlan {
  id                  Int      @id @default(autoincrement())
  name                String
  priceMonthly        Float
  priceYearly         Float
  employeeLimit       Int
  hrLimit             Int
  storageLimit        String
  payrollAccess       Boolean
  documentAccess      Boolean
  includedBranchLimit Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ── NEW Employee-Based Subscription System (Beta) ────────────────────────────
// FULLY ADDITIVE & ISOLATED. Runs ALONGSIDE the existing SubscriptionPlan /
// Billing system and never reads or writes its tables. Billing model:
//   monthly = peakEmployeeCount × employeePrice + purchasedBranchSlots × branchPrice
// All three tables are standalone (scalar FKs only) so they cannot affect any
// existing relationship, customer, or calculation.

// One row per company that has been onboarded onto the new (beta) model.
model EmployeeSubscription {
  id                   Int       @id @default(autoincrement())
  companyId            Int       @unique
  employeePrice        Float? // per-company override; null → use global default
  branchPrice          Float? // per-company override; null → use global default
  peakEmployeeCount    Int       @default(0) // high-water mark; never auto-decreases
  purchasedBranchSlots Int       @default(1) // every company starts with 1 slot
  discountPercent      Float     @default(0)
  status               String    @default("Active") // Active / Suspended / Cancelled
  paymentStatus        String    @default("Pending") // Paid / Pending / Overdue
  validUntil           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// Singleton global defaults (Super Admin editable).
model EmployeeSubscriptionConfig {
  id            Int      @id @default(autoincrement())
  employeePrice Float    @default(100)
  branchPrice   Float    @default(500)
  updatedAt     DateTime @updatedAt
}

// Immutable audit of every billing-related change.
model SubscriptionBillingAudit {
  id          Int      @id @default(autoincrement())
  companyId   Int?
  companyName String?
  field       String
  oldValue    String?
  newValue    String?
  changedBy   String?
  reason      String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([companyId])
}

// ── Subscription Management (Super Admin) ────────────────────────────────────
// ONE row per company = its live subscription. Additive & isolated (scalar
// companyId, no relations). The plan tier is ALSO mirrored onto Company.plan so
// the existing permission engine (planEntitlements + subscriptionMiddleware)
// stays the single enforcement source of truth. Pricing is per-employee-per-
// billing-period, derived from the plan tier + cycle (code map) EXCEPT for
// Custom, whose price + entitlement allow-lists are stored here.
model CompanySubscription {
  id               Int       @id @default(autoincrement())
  companyId        Int       @unique
  plan             String    @default("Free") // Free / Starter / Professional / Enterprise / Custom
  billingCycle     String    @default("Quarterly") // Quarterly / Yearly
  status           String    @default("Active") // Active / Suspended / Expired / Cancelled
  pricePerEmployee Float? // Custom (or a per-company override); standard tiers derive from the code map
  discountPercent  Float     @default(0)
  renewalDate      DateTime?
  // Custom-plan overrides (null → derive from the plan's code-map defaults):
  employeeLimit    Int?
  branchLimit      Int?
  storageMB        Int?
  adminUserLimit   Int?
  customModules    Json? // Custom: allowed module permission keys
  customReports    Json? // Custom: allowed report keys (or "all")
  customFeatures   Json? // Custom: forward-looking feature flags
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// Append-only history of subscription/plan changes (Super Admin audit trail).
model SubscriptionHistory {
  id          Int      @id @default(autoincrement())
  companyId   Int
  companyName String?
  changedBy   String?
  oldPlan     String?
  newPlan     String?
  oldCycle    String?
  newCycle    String?
  oldAmount   Float?
  newAmount   Float?
  reason      String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([companyId])
}

// ── Subscription Billing (Super Admin) ───────────────────────────────────────
// A REAL GST invoice per company subscription billing period. Additive & isolated
// (scalar companyId, no relations) — distinct from the company-side Invoice model
// (companies invoicing THEIR customers). Every invoice is linked to a company +
// plan + headcount + cycle and carries a full GST breakdown. Snapshots company
// identity so a historical invoice never changes if the company later edits.
model SubscriptionInvoice {
  id               Int       @id @default(autoincrement())
  invoiceNo        String    @unique
  companyId        Int
  companyName      String?
  companyHead      String?
  companyEmail     String?
  billingAddress   String?   @db.Text
  gstin            String?
  plan             String    @default("Free")
  billingCycle     String    @default("Quarterly") // Quarterly / Yearly
  periodStart      DateTime?
  periodEnd        DateTime?
  employeeCount    Int       @default(0)
  pricePerEmployee Float     @default(0)
  subtotal         Float     @default(0)
  discountPercent  Float     @default(0)
  discountAmount   Float     @default(0)
  gstPercent       Float     @default(0)
  gstAmount        Float     @default(0)
  cgst             Float     @default(0)
  sgst             Float     @default(0)
  igst             Float     @default(0)
  interState       Boolean   @default(false)
  grandTotal       Float     @default(0)
  amountPaid       Float     @default(0)
  status           String    @default("Pending") // Draft/Pending/Paid/Overdue/Cancelled/Refunded
  invoiceDate      DateTime  @default(now())
  dueDate          DateTime?
  notes            String?   @db.Text
  terms            String?   @db.Text
  createdBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // ── Interactive invoice editor (Super Admin) — all additive/nullable ──
  // Editable line items ([{id,description,hsn,quantity,rate,discountPercent,
  // taxPercent}]). NULL → legacy headcount×rate invoice; the editor seeds one
  // item from those columns on first edit and keeps the legacy totals in sync.
  lineItems        Json?
  pan              String?
  contactPerson    String?
  companyPhone     String?
  bankDetails      String?   @db.Text
  roundOff         Float     @default(0)
  editUnlocked     Boolean   @default(false) // Paid/Cancelled invoices explicitly unlocked for edit
  finalizedAt      DateTime?

  @@index([companyId])
  @@index([status])
}

// Append-only edit trail for the Subscription invoice editor: one row per changed
// field per save (old → new, who, why). Isolated scalar invoiceId (no relation).
model SubscriptionInvoiceAudit {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  invoiceNo   String?
  field       String
  oldValue    String?  @db.Text
  newValue    String?  @db.Text
  action      String   @default("EDIT") // EDIT / FINALIZE / UNLOCK
  reason      String?  @db.Text
  changedBy   String?
  createdAt   DateTime @default(now())

  @@index([invoiceId])
  @@map("subscription_invoice_audit")
}

// Payment(s) recorded against a subscription invoice (partial payments allowed).
model SubscriptionInvoicePayment {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  companyId   Int?
  amount      Float
  method      String? // Cash / Bank Transfer / UPI / Card / Cheque / Other
  referenceNo String?
  paidAt      DateTime @default(now())
  collectedBy String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

// ── Task Manager ─────────────────────────────────────────────────────────────
// Standalone tables (scalar foreign keys, no relations on existing models) so
// adding this module cannot alter or break any existing relationship.
model Task {
  id             Int      @id @default(autoincrement())
  title          String
  description    String?  @db.Text
  priority       String   @default("Medium") // Low / Medium / High / Critical
  status         String   @default("In Progress") // In Progress / Completed / Cancelled ("Overdue" is CALCULATED from dueDate, never stored)
  startDate      String?
  dueDate        String?
  startTime      String?
  endTime        String?
  companyId      Int?
  branchId       Int?
  createdById    Int
  createdByName  String   @default("")
  createdByRole  String?
  assignmentType String   @default("user") // user / multiple / department / branch / role
  assigneeIds    Json     @default(dbgenerated("(JSON_ARRAY())")) // [userId, ...]
  assigneeNames  Json     @default(dbgenerated("(JSON_ARRAY())")) // [name, ...]
  department     String?
  targetRole     String?
  mentions       Json     @default(dbgenerated("(JSON_ARRAY())")) // [username, ...]
  attachments    Json     @default(dbgenerated("(JSON_ARRAY())")) // [{name,type,url,size}]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId])
  @@index([createdById])
}

model TaskComment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int?
  userName  String   @default("")
  message   String   @db.Text
  parentId  Int? // set when this is a reply to another comment
  isStatus  Boolean  @default(false) // true for status-change system notes
  createdAt DateTime @default(now())

  @@index([taskId])
}

// ── Tender Information (future-ready; placeholder data for now) ───────────────
model Tender {
  id                  Int      @id @default(autoincrement())
  tenderNumber        String?
  tenderName          String
  department          String?
  tenderValue         Float    @default(0)
  publishDate         String?
  closingDate         String?
  status              String   @default("Draft") // Draft / Submitted / Under Review / Won / Lost / Cancelled
  documentPath        String?
  category            String? // Government / Private / HR Service / Recruitment / Vendor
  companyId           Int?
  notes               String?  @db.Text
  // ── Tenders & Contracts lifecycle additions ──
  clientName          String?
  branchId            Int?
  serviceType         String? // e.g. Security / Housekeeping / Manpower
  startDate           String?
  endDate             String?
  remarks             String?  @db.Text
  convertedContractId Int? // set once a Won tender is converted to a Contract
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  contract Contract?

  @@index([companyId])
}

// ── Contract (auto-created from a Won tender) ──────────────────────────────
model Contract {
  id             Int      @id @default(autoincrement())
  contractNumber String?
  contractName   String
  clientName     String?
  companyId      Int
  branchId       Int?
  tenderId       Int?     @unique // source tender (1:1)
  contractValue  Float    @default(0)
  startDate      String?
  endDate        String?
  status         String   @default("Active") // Active / Expiring Soon / Expired / Closed
  documentPath   String?
  notes          String?  @db.Text
  // ── Enterprise contract data (additive — never replaces the columns above) ──
  // All extended sections (contract info extras, client, timeline, financial,
  // bank guarantee, security deposit, performance guarantee, tender snapshot,
  // approval, renewal, compliance) live here as one structured object.
  details        Json?
  // Uploaded files: [{ id, category, name, dataUrl, size, type, uploadedAt, uploadedBy, version }]
  documents      Json?
  // Append-only audit/activity timeline: [{ at, by, action, field?, old?, new? }]
  activity       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tender      Tender?        @relation(fields: [tenderId], references: [id], onDelete: SetNull)
  sites       ContractSite[]
  deployments Deployment[]

  @@index([companyId])
  @@map("contracts")
}

// ── Site under a contract (a contract can have many sites) ──────────────────
model ContractSite {
  id                Int      @id @default(autoincrement())
  contractId        Int
  companyId         Int
  siteName          String
  siteAddress       String?  @db.Text
  siteSupervisor    String?
  requiredHeadcount Int      @default(0)
  status            String   @default("Active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  contract    Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  deployments Deployment[]

  @@index([contractId])
  @@index([companyId])
  @@map("contract_sites")
}

// ── Deployment of an employee to a site (split across sites supported) ──────
model Deployment {
  id                Int      @id @default(autoincrement())
  contractId        Int
  siteId            Int
  employeeId        Int
  companyId         Int
  roleAtSite        String?
  assignmentDate    String?
  releaseDate       String?
  allocationPercent Int      @default(100) // employee may be split across sites
  status            String   @default("Assigned") // Assigned / Transferred / Released
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  contract Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  site     ContractSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([siteId])
  @@index([employeeId])
  @@index([companyId])
  @@map("deployments")
}

// ── Communication Center (Phase 1 foundation — storage only, NO sending) ──────
// Fully independent module: scalar companyId (no Company relation) so it never
// touches the wide Company table or other modules. Designed so Phase 2 channels
// (WhatsApp/SMS/Email/Push) slot in via the existing channel/status/recipients
// columns without a schema redesign.
model CommunicationTemplate {
  id                       Int      @id @default(autoincrement())
  companyId                Int
  title                    String
  category                 String   @default("Custom Templates")
  subject                  String?  @db.Text
  body                     String?  @db.Text
  status                   String   @default("Draft") // Draft / Active / Archived
  backgroundImage          String?  @db.LongText
  companyLogo              String?  @db.LongText
  employeePhotoPlaceholder Boolean  @default(true)
  placeholders             String?  @db.Text // JSON array of placeholder keys used
  layout                   String?  @db.LongText // drag-and-drop designer layout (stored only in Phase 1)
  festivalName             String?
  festivalDate             String?
  // ── WhatsApp readiness (Phase 1 — stored only, never sent) ──────────────────
  whatsappCompatible       Boolean  @default(false) // template can be used over WhatsApp
  whatsappRichText         Boolean  @default(false) // body uses WhatsApp rich text (*bold* / _italic_)
  whatsappCaption          String?  @db.Text // caption shown beneath the image when sent as media
  // ── Enterprise workflow (additive) ──────────────────────────────────────────
  masterTemplateId         Int?     // provenance: the master library template this was copied from (null = authored in-company)
  libraryState             String   @default("enabled") // company-library management: enabled / disabled / archived
  createdBy                String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([companyId])
  @@index([category])
  @@map("communication_templates")
}

// ── Master Template Library (Super-Admin governed, global — companies COPY, never modify) ──
// Platform-level catalog of professional templates. Company Head / HR browse this
// and copy a template into their own communication_templates (which sets
// masterTemplateId provenance). The master rows themselves are NEVER edited by a
// company. Reuses the exact same design JSON shape as communication_templates so
// the existing GreetingCard renderer / image pipeline render them unchanged.
model CommunicationMasterTemplate {
  id                 Int      @id @default(autoincrement())
  title              String
  category           String   // Birthday / Work Anniversary / Joining / Promotion / Confirmation / Leave / Attendance / Payroll / Payslip / Loan / Compliance / Festival / Holiday / Announcement / Custom
  festivalKey        String   @default("") // sub-key for Festival/Holiday (diwali, christmas, holi, eid, new-year, …) — "" for non-festival
  subject            String?  @db.Text
  body               String?  @db.Text
  placeholders       String?  @db.Text
  layout             String?  @db.LongText // design JSON (theme/layout/art) — identical shape to communication_templates.layout
  backgroundImage    String?  @db.LongText
  whatsappCompatible Boolean  @default(true)
  whatsappCaption    String?  @db.Text
  status             String   @default("Active") // Active / Archived (master-side lifecycle)
  sortOrder          Int      @default(0)
  createdBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([category])
  @@map("communication_master_templates")
}

// ── Event → Template Mapping (per company) ──────────────────────────────────────
// THE workflow spine: for each event a company picks ONE company template + which
// channels are on + whether the automation is enabled. Saving a mapping keeps the
// underlying canonical automation_rule in sync (template + on/off) so the EXISTING
// scheduler/engine send it automatically — no engine rewrite. One row per
// (company, event, festivalKey).
model CommunicationEventMapping {
  id               Int      @id @default(autoincrement())
  companyId        Int
  eventKey         String   // birthday / anniversary / joining / promotion / confirmation / leave_approved / attendance / payroll / payslip / loan / compliance / festival / holiday / announcement / custom
  festivalKey      String   @default("") // festival/holiday sub-event (diwali, christmas, …); "" otherwise
  hrmateTemplateId Int?     // chosen company template (communication_templates.id); null = NOT configured
  whatsappEnabled  Boolean  @default(true)
  emailEnabled     Boolean  @default(false)
  enabled          Boolean  @default(false) // is this event's automation switched on
  ruleId           Int?     // the canonical automation_rule kept in sync with this mapping
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([companyId, eventKey, festivalKey])
  @@index([companyId])
  @@map("communication_event_mappings")
}

model CommunicationSchedule {
  id           Int      @id @default(autoincrement())
  companyId    Int
  name         String
  templateId   Int?
  channel      String   @default("none") // Phase 2: whatsapp / sms / email / push
  scheduleDate String?
  scheduleTime String?
  recurrence   String   @default("none") // none / daily / weekly / monthly / yearly
  recipients   String?  @db.Text // JSON (criteria or ids) — stored only, never executed in Phase 1
  status       String   @default("Scheduled") // Scheduled / Paused / Cancelled
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
  @@map("communication_schedules")
}

model CommunicationAnnouncement {
  id             Int      @id @default(autoincrement())
  companyId      Int
  title          String
  message        String?  @db.Text
  attachment     String?  @db.LongText
  attachmentName String?
  priority       String   @default("Normal") // Low / Normal / High / Urgent
  expiryDate     String?
  status         String   @default("Draft") // Draft / Published / Expired
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId])
  @@map("communication_announcements")
}

model CommunicationDeliveryLog {
  id             Int      @id @default(autoincrement())
  companyId      Int
  templateId     Int?
  channel        String?
  recipientCount Int      @default(0)
  status         String   @default("Pending")
  createdAt      DateTime @default(now())

  @@index([companyId])
  @@map("communication_delivery_logs")
}

model CommunicationSettings {
  id                Int      @id @default(autoincrement())
  companyId         Int      @unique
  emailProvider     String?
  smsProvider       String?
  whatsappProvider  String?
  pushEnabled       Boolean  @default(false)
  timezone          String?  @default("Asia/Kolkata")
  workingHoursStart String?
  workingHoursEnd   String?
  config            String?  @db.Text // future JSON config
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("communication_settings")
}

// Holiday Calendar (Phase 1) — company holiday master. Drives future automatic
// festival greetings & announcements (Phase 2). Fully isolated (scalar companyId,
// no Company relation) to stay independent and avoid the Company row-size limit.
model CommunicationHoliday {
  id                    Int      @id @default(autoincrement())
  companyId             Int
  name                  String
  category              String   @default("Public Holiday") // Public / Optional / National / Religious / Regional / Company
  date                  String   // YYYY-MM-DD
  applicableBranches    String?  @db.Text // JSON array of branch ids, or "all"
  applicableDepartments String?  @db.Text // JSON array of departments, or "all"
  description           String?  @db.Text
  isPublicHoliday       Boolean  @default(true)
  isOptionalHoliday     Boolean  @default(false)
  isRecurring           Boolean  @default(false) // repeats every year
  status                String   @default("Active") // Active / Inactive
  createdBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([companyId])
  @@index([date])
  @@map("communication_holidays")
}

// ── WhatsApp integration foundation (Phase 1 — NO messages are ever sent) ──────
// Prepares HRMate for the Meta WhatsApp Business Cloud API. Phase 1 only stores
// configuration, queues simulated messages, and writes simulated delivery logs.
// Fully isolated (scalar companyId, no Company relation) like the rest of the
// Communication Center. In Phase 2 the WhatsAppService gains a real Meta client;
// nothing else about these tables needs to change.

// One row per company — connection + development-mode + (future) Meta credentials.
model WhatsAppSettings {
  id               Int      @id @default(autoincrement())
  companyId        Int      @unique
  enabled          Boolean  @default(false) // master ON/OFF for WhatsApp communication
  connectionStatus String   @default("not_connected") // not_connected / pending / connected
  // Development Mode — when ON every message is redirected to developerTestNumber.
  developmentMode    Boolean @default(true)
  developerTestNumber String? // e.g. +91XXXXXXXXXX — the single test recipient
  // Future Meta credentials — captured in Phase 2 (UI shows them disabled now).
  metaBusinessId            String?
  whatsappBusinessAccountId String?
  phoneNumberId             String?
  permanentAccessToken      String?  @db.Text // stored ENCRYPTED at rest (secretCrypto)
  verifyToken               String?  @db.Text // stored ENCRYPTED at rest (secretCrypto)
  webhookUrl                String?
  // Phase 2 — live Meta connection state (set by the connection test).
  apiVersion       String?         // e.g. "v21.0"
  phoneVerified    Boolean  @default(false)
  tokenValid       Boolean  @default(false)
  lastConnectedAt  DateTime?
  // Phase 2.5 — credential health history & production readiness.
  businessVerified  Boolean  @default(false)
  environment       String?         // "sandbox" / "production"
  tokenExpired      Boolean  @default(false)
  lastSuccessAt     DateTime?
  lastFailureAt     DateTime?
  lastError         String?  @db.Text
  lastHttpStatus    Int?
  lastMetaErrorCode String?
  lastTestedAt      DateTime?
  // Phase 5 — webhook health + Meta account signals (all additive, nullable).
  webhookVerified      Boolean  @default(false) // GET verification handshake succeeded
  lastWebhookAt        DateTime?                 // last inbound status webhook received
  webhookFailureReason String?  @db.Text
  qualityRating        String?                   // GREEN / YELLOW / RED (if Meta returns it)
  messagingLimitTier   String?                   // e.g. TIER_1K / TIER_10K (if available)
  // Image-template integration — render HRMate gallery designs and send them as
  // approved WhatsApp IMAGE templates (header media). All additive, nullable.
  imageTemplateDefault String?                   // Meta template name used when no mapping matches
  imageTemplateLang    String?                   // default Meta template language code (e.g. en_US)
  imageTemplateMap     String?  @db.Text         // JSON: { byCategory:{cat:tplName}, byTemplateId:{id:tplName} }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("whatsapp_settings")
}

// ── Phase 3 — WhatsApp Business Template Management & Approval ─────────────────
// Synced catalog of the company's Meta-approved WhatsApp message templates. This
// is SEPARATE from communication_templates (HRMate greeting templates) — never
// overwrites them. Fully isolated (scalar companyId).
model WhatsAppMetaTemplate {
  id                 Int      @id @default(autoincrement())
  companyId          Int
  metaTemplateId     String?
  name               String
  category           String?  // MARKETING / UTILITY / AUTHENTICATION
  language           String?  // e.g. en, en_US, gu, hi
  status             String?  // APPROVED / PENDING / REJECTED / DISABLED / PAUSED
  components         String?  @db.Text // JSON array from Meta
  version            String?  // content hash (Meta has no version field) to detect edits
  bodyVariableCount  Int      @default(0)
  headerFormat       String?  // TEXT / IMAGE / DOCUMENT / VIDEO / null
  previousStatus     String?
  lastStatusChangeAt DateTime?
  lastSyncedAt       DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([companyId])
  @@map("whatsapp_meta_templates")
}

// Maps one HRMate (communication_templates) template → one Meta template, per
// language, with a positional variable map ({{1}}→employee_name, …). Scalar
// hrmateTemplateId (no FK) keeps the module isolated.
model WhatsAppTemplateMapping {
  id                  Int      @id @default(autoincrement())
  companyId           Int
  hrmateTemplateId    Int?
  hrmateTemplateName  String?
  metaTemplateName    String
  metaTemplateId      String?
  language            String   @default("en")
  status              String?  // snapshot of Meta status (refreshed on sync)
  variableMap         String?  @db.Text // JSON { "1": "employee_name", ... }
  headerMediaType     String?  // none / image / document / video
  headerMediaUrl      String?  @db.Text
  active              Boolean  @default(false) // usable only when Meta status APPROVED
  lastModifiedAt      DateTime?
  lastApprovalStatus  String?
  lastApprovalChangeAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([companyId])
  @@map("whatsapp_template_mappings")
}

// Version / approval / sync history for WhatsApp templates & mappings.
model WhatsAppTemplateEvent {
  id           Int      @id @default(autoincrement())
  companyId    Int
  templateName String?
  language     String?
  event        String   // synced / status_change / version_change / mapped / mapping_updated / test_sent
  fromValue    String?
  toValue      String?
  detail       String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([companyId])
  @@map("whatsapp_template_events")
}

// ── Phase 4 — Communication Automation Engine ─────────────────────────────────
// Generic rules engine that drives ALL communications (birthday/anniversary/
// festival/announcement/salary/payslip/leave/attendance/custom) over the SAME
// workflow: resolve recipients → eligibility → render → generate QUEUE entries
// (never sends directly). Fully isolated (scalar companyId).
model AutomationRule {
  id                 Int      @id @default(autoincrement())
  companyId          Int
  name               String
  eventType          String   // birthday/anniversary/festival/announcement/salary_credited/payslip/leave_approved/attendance_reminder/custom
  triggerType        String   @default("manual") // daily/weekly/monthly/yearly/specific_date/employee_birthday/employee_anniversary/company_holiday/manual/api
  recipientScope     String   @default("all_active") // today_birthday/today_anniversary/all_active/specific_employee/not_checked_in
  channel            String   @default("whatsapp")
  templateMappingId  Int?     // WhatsAppTemplateMapping (preferred)
  hrmateTemplateId   Int?     // or a communication_templates fallback
  language           String   @default("en")
  scheduleTime       String?  // HH:mm
  scheduleDay        Int?     // 0–6 (weekly) or 1–31 (monthly)
  scheduleMonth      Int?     // 1–12 (yearly)
  specificDate       String?  // YYYY-MM-DD
  specificEmployeeId Int?
  status             String   @default("active") // active/paused
  dryRun             Boolean  @default(false)
  timezone           String?  // IANA tz for scheduleTime matching (default Asia/Kolkata)
  createdBy          String?
  lastRunAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([companyId])
  @@map("automation_rules")
}

// Execution history for automation runs (run / preview / dry_run).
model AutomationRun {
  id                  Int      @id @default(autoincrement())
  companyId           Int
  ruleId             Int?
  ruleName           String?
  mode               String   @default("run") // run / preview / dry_run
  triggerType        String?
  recipientsEvaluated Int     @default(0)
  eligibleRecipients Int      @default(0)
  queuedMessages     Int      @default(0)
  skippedMessages    Int      @default(0)
  errorsCount        Int      @default(0)
  sentMessages       Int?     // 'send' mode: messages actually delivered to Meta (200 + wamid)
  failedMessages     Int?     // 'send' mode: messages that failed at Meta
  durationMs         Int?
  detail             String?  @db.Text // JSON: per-recipient outcomes (sample), errors
  createdAt          DateTime @default(now())

  @@index([companyId])
  @@index([ruleId])
  @@map("automation_runs")
}

// Phase 2.5 — internal API request history for the Meta Cloud API. NEVER stores
// credentials; only operational metadata (endpoint/method/status/duration).
model WhatsAppRequestLog {
  id            Int      @id @default(autoincrement())
  companyId     Int
  operation     String?         // connection_test / send_test
  endpoint      String?  @db.Text
  method        String?
  httpStatus    Int?
  ok            Boolean  @default(false)
  metaMessageId String?
  metaErrorCode String?
  durationMs    Int?
  createdAt     DateTime @default(now())

  @@index([companyId])
  @@map("whatsapp_request_logs")
}

// Outbound message queue. Phase 1 only ever stores rows (status Pending) — the
// queue is NEVER drained against a real API. Statuses model the full lifecycle so
// Phase 2 can flip them: Pending → Processing → Sent / Failed.
model WhatsAppQueue {
  id             Int      @id @default(autoincrement())
  companyId      Int
  employeeId     Int?
  employeeName   String?
  templateId     Int?
  templateName   String?
  originalNumber String?  // the employee's real mobile (audit trail)
  resolvedNumber String?  // where it WOULD go (dev test number when dev mode ON)
  payload        String?  @db.Text // rendered message snapshot (JSON) — no PII rendering in Phase 1
  status         String   @default("Pending") // Pending / Processing / Sent / Failed
  attempts       Int      @default(0)
  errorMessage   String?  @db.Text
  developmentMode Boolean @default(true)
  simulated      Boolean  @default(true) // Phase 1 rows are always simulated
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@map("whatsapp_queue")
}

// Delivery audit log. Records every attempt (simulated in Phase 1) with the
// original vs. actually-sent number so dev-mode redirection is fully traceable.
model WhatsAppDeliveryLog {
  id               Int      @id @default(autoincrement())
  companyId        Int
  employeeId       Int?
  employeeName     String?
  originalNumber   String?  // the employee's real mobile
  actualSentNumber String?  // dev test number when dev mode ON, else originalNumber
  templateId       Int?
  templateName     String?
  status           String   @default("Pending") // Pending / Simulated / Sent / Failed
  errorMessage     String?  @db.Text
  developmentMode  Boolean  @default(true)
  simulated        Boolean  @default(true)
  // Phase 1.5 diagnostics (additive, nullable) — richer delivery log.
  queueId          Int?            // linked whatsapp_queue row
  messagePreview   String?  @db.Text // rendered message snapshot for the log view
  processingMs     Int?            // simulated processing time (ms)
  // Phase 2 — real Meta Cloud API delivery metadata (additive, nullable).
  provider         String?         // e.g. "Meta Cloud API" (null = simulated)
  metaMessageId    String?         // wamid returned by Meta on success
  errorCode        String?         // Meta error code on failure
  httpStatus       Int?            // HTTP status from the Graph API call
  // Phase 5 — delivery lifecycle, driven by the Meta status webhook (additive).
  metaStatus       String?         // last Meta webhook status: sent/delivered/read/failed
  sentAt           DateTime?       // Meta "sent" timestamp
  deliveredAt      DateTime?       // Meta "delivered" timestamp
  readAt           DateTime?       // Meta "read" timestamp
  failedAt         DateTime?       // Meta "failed" timestamp
  failureReason    String?  @db.Text
  automationRuleId Int?            // originating automation rule (for search/inspector)
  branch           String?         // recipient branch snapshot (for search/inspector)
  createdAt        DateTime @default(now())

  @@index([companyId])
  @@index([status])
  @@index([metaMessageId])
  @@map("whatsapp_delivery_logs")
}

// Phase 5 — raw Meta status webhook events (one row per status transition per
// message). Fully isolated (scalar companyId). Idempotent via (metaMessageId,
// status) uniqueness so Meta's at-least-once delivery never double-records.
model WhatsAppWebhookEvent {
  id            Int      @id @default(autoincrement())
  companyId     Int
  metaMessageId String?  // wamid the event refers to
  status        String   // sent / delivered / read / failed
  recipient     String?  // recipient wa_id
  eventAt       DateTime? // timestamp Meta reported for the status
  errorCode     String?
  errorTitle    String?  @db.Text
  raw           String?  @db.Text // raw event JSON (for the inspector)
  createdAt     DateTime @default(now())

  @@unique([metaMessageId, status], name: "wamid_status")
  @@index([companyId])
  @@index([metaMessageId])
  @@map("whatsapp_webhook_events")
}

// Support Session — the ONLY audited way a Super Admin (platform admin) may enter
// a company's HR environment. Multi-tenant privacy: without an active session the
// backend blocks Super Admin from all employee-PII APIs. Fully isolated (scalar
// ids, no relations) to stay independent.
model SupportSession {
  id             Int       @id @default(autoincrement())
  companyId      Int
  companyName    String?
  superAdminId   Int
  superAdminName String?
  reason         String    @db.Text
  ticketNumber   String?
  status         String    @default("active") // active / ended / expired
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  expiresAt      DateTime?
  ipAddress      String?
  userAgent      String?   @db.Text
  actionCount    Int       @default(0)

  @@index([superAdminId])
  @@index([companyId])
  @@index([status])
  @@map("support_sessions")
}

// ── Payroll Component Builder ────────────────────────────────────────────────
// Enterprise payroll component master (Allowance / Deduction / Reimbursement /
// Bonus / Incentive / Employer Contribution / Loan / Recovery / Custom). Full
// CRUD, taxability, statutory impact, formula/calculation config, effective
// dates and lifecycle status. Relation-less (companyId Int only) so the maxed-out
// Company model is never touched — mirrors the bonus/etime additive models.
// `usageCount` gates hard-delete: a component that has been used by a payroll run
// can only be archived/deactivated, never permanently deleted.
model PayrollComponent {
  id                Int      @id @default(autoincrement())
  companyId         Int
  componentName     String
  displayName       String?
  shortCode         String?
  description       String?  @db.Text
  componentType     String // Allowance / Deduction / Reimbursement / Bonus / Incentive / Employer Contribution / Loan / Recovery / Custom
  payrollCategory   String   @default("Fixed") // Fixed / Variable / Attendance Based / Performance Based / Formula Based / Manual Entry
  calculationMethod String   @default("Fixed Amount") // Fixed Amount / Percentage of Basic / Percentage of Gross / Formula Builder / Manual
  amount            Float?   @default(0) // for "Fixed Amount"
  percentage        Float?   @default(0) // for the "Percentage of …" methods
  formula           String?  @db.Text // for "Formula Builder"
  taxable           String   @default("Taxable") // Taxable / Non-Taxable / Partially Taxable
  taxablePercent    Float?   @default(0) // for "Partially Taxable"
  pfApplicable      Boolean  @default(false)
  esicApplicable    Boolean  @default(false)
  ptApplicable      Boolean  @default(false)
  lwfApplicable     Boolean  @default(false)
  tdsApplicable     Boolean  @default(false)
  effectiveFrom     String? // yyyy-MM-dd
  effectiveTo       String? // yyyy-MM-dd
  status            String   @default("Active") // Active / Inactive / Archived
  displayOrder      Int      @default(0)
  usageCount        Int      @default(0) // >0 → protected from hard-delete
  lastUsedAt        DateTime?
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, componentType])
  @@index([companyId, status])
  @@map("payroll_components")
}

// Immutable change history for a payroll component (Created / Updated / Cloned /
// Activated / Deactivated / Archived / Deleted). Relation-less; the View drawer
// reads this to show the audit trail (who / when / what changed).
model PayrollComponentAudit {
  id          Int      @id @default(autoincrement())
  companyId   Int
  componentId Int
  action      String // CREATED / UPDATED / CLONED / ACTIVATED / DEACTIVATED / ARCHIVED / DELETED
  changedBy   String?
  changes     String?  @db.Text // JSON summary of field-level changes
  createdAt   DateTime @default(now())

  @@index([componentId])
  @@index([companyId])
  @@map("payroll_component_audits")
}

// ── Invoice Management (isolated financial module) ───────────────────────────
// A self-contained billing module. ALL models are relation-less (companyId Int
// only, mirrors the bonus/etime/payroll-component pattern) so the maxed-out
// Company model and every existing table are UNTOUCHED. No FK to Employee/Payroll
// /Attendance — this module cannot affect HR/payroll data. Additive migration via
// scripts/addInvoiceModule.js; NEVER `prisma db push`.

model InvoiceCustomer {
  id            Int      @id @default(autoincrement())
  companyId     Int
  customerCode  String?  // Client Master code e.g. CLI-000001 (assigned once, per company)
  companyName   String
  contactPerson String?
  gstin         String?
  pan           String?
  email         String?
  phone         String?
  addressLine   String?  @db.Text
  shipToAddress String?  @db.Text // default shipping address (auto-filled onto new invoices)
  city          String?
  state         String?
  country       String?  @default("India")
  paymentTerms  String?  // default payment terms auto-filled onto new invoices
  creditDays    Int?     // default credit period → seeds invoice due date
  isActive      Boolean  @default(true)
  notes         String?  @db.Text
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, customerCode])
  @@index([companyId])
  @@index([companyId, isActive])
  @@map("invoice_customers")
}

model InvoiceProduct {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String
  hsnSac      String?
  description String?  @db.Text
  unit        String?  @default("Nos")
  rate        Float    @default(0)
  taxRate     Float    @default(0) // GST %
  isActive    Boolean  @default(true)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@map("invoice_products")
}

model Invoice {
  id            Int      @id @default(autoincrement())
  companyId     Int
  invoiceNumber String
  customerId    Int?
  // Customer snapshot (invoice stays immutable if the customer record changes).
  billToName    String
  billToGstin   String?
  billToAddress String?  @db.Text
  billToShipAddress String? @db.Text // ship-to snapshot (from client master; optional, default-hidden)

  // ── Dispatch & Destination (GST invoice logistics) ────────────────────────
  // Scalar columns rather than a JSON blob: vehicleNumber / lrNumber are exactly
  // what gets reconciled against e-way bills, and JSON would make that
  // unqueryable. All nullable — a service invoice simply leaves them blank and
  // the sections then render nothing.
  // The DELIVERY ADDRESS deliberately reuses billToShipAddress above instead of
  // adding a second address column that could disagree with it.
  dispatchFrom      String? @db.VarChar(160) // warehouse / branch the goods leave from
  dispatchAddress   String? @db.Text
  dispatchCity      String? @db.VarChar(100)
  dispatchState     String? @db.VarChar(100)
  dispatchPincode   String? @db.VarChar(12)
  dispatchDate      String? @db.VarChar(10)  // yyyy-MM-dd, same convention as invoiceDate
  dispatchThrough   String? @db.VarChar(160) // courier / transporter
  vehicleNumber     String? @db.VarChar(40)
  lrNumber          String? @db.VarChar(60)  // LR / AWB

  shipToName        String? @db.VarChar(160)
  shipToCity        String? @db.VarChar(100)
  shipToState       String? @db.VarChar(100)
  shipToPincode     String? @db.VarChar(12)
  shipToCountry     String? @db.VarChar(100)
  billToEmail   String?
  billToPhone   String?
  billToState   String?
  invoiceDate   String // yyyy-MM-dd
  dueDate       String?
  // Service-invoice header references (ALL optional & additive — existing rows
  // stay NULL and simply hide the line). Used by the professional template.
  contractNo    String?  @db.VarChar(100)
  referenceNo   String?  @db.VarChar(100)
  poNumber      String?  @db.VarChar(100)
  billingPeriod String?  @db.VarChar(100)
  currency      String   @default("INR")
  paymentTerms  String?
  placeOfSupply String? // customer state → decides CGST+SGST vs IGST
  // Status workflow: Draft→Generated→Sent→Viewed→Partially Paid→Paid→Closed | Cancelled
  status        String   @default("Draft")
  // Money (server-computed; all ≥ 0).
  subtotal      Float    @default(0)
  discountTotal Float    @default(0)
  taxableAmount Float    @default(0)
  cgst          Float    @default(0)
  sgst          Float    @default(0)
  igst          Float    @default(0)
  roundOff      Float    @default(0)
  grandTotal    Float    @default(0)
  amountPaid    Float    @default(0)
  balanceDue    Float    @default(0)
  // Presentation / payment info.
  notes            String? @db.Text
  termsConditions  String? @db.Text
  paymentMode      String?
  bankDetails      String? @db.Text
  upiId            String?
  // Per-invoice branding OVERRIDE as JSON {logo,signature,stamp,qr}. NULL (the
  // default) = this invoice uses the company / Company-Profile branding.
  brandingOverride String? @db.Text
  isRecurringChild Boolean @default(false)
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@map("invoices")
}

model InvoiceItem {
  id           Int     @id @default(autoincrement())
  companyId    Int
  invoiceId    Int
  productId    Int?
  name         String
  description  String? @db.Text
  hsnSac       String?
  quantity     Float   @default(1)
  unit         String? @default("Nos")
  rate         Float   @default(0)
  discountPct  Float   @default(0)
  discountAmt  Float   @default(0)
  taxRate      Float   @default(0)
  taxableValue Float   @default(0)
  cgst         Float   @default(0)
  sgst         Float   @default(0)
  igst         Float   @default(0)
  amount       Float   @default(0) // line total incl. tax
  sortOrder    Int     @default(0)

  @@index([invoiceId])
  @@index([companyId])
  @@map("invoice_items")
}

model InvoicePayment {
  id              Int      @id @default(autoincrement())
  companyId       Int
  invoiceId       Int
  amount          Float    @default(0)
  paymentDate     String // yyyy-MM-dd
  mode            String   @default("Bank") // Cash / Bank / UPI / Cheque / Card / Other
  referenceNumber String?
  notes           String?  @db.Text
  status          String   @default("Paid") // Paid / Partial / Pending / Failed / Refunded
  recordedBy      String?
  createdAt       DateTime @default(now())

  @@index([invoiceId])
  @@index([companyId])
  @@map("invoice_payments")
}

model InvoiceSettings {
  id                  Int      @id @default(autoincrement())
  companyId           Int      @unique
  invoicePrefix       String   @default("INV")
  numberFormat        String   @default("{PREFIX}-{FY}-{SEQ}") // tokens: {PREFIX}{FY}{YYYY}{MM}{SEQ}
  nextNumber          Int      @default(1)
  seqPadding          Int      @default(4)
  defaultCurrency     String   @default("INR")
  defaultPaymentTerms String?  @default("Net 30")
  defaultNotes        String?  @db.Text
  defaultTerms        String?  @db.Text
  companyGstin        String?
  bankDetails         String?  @db.Text
  upiId               String?
  logoUrl             String?  @db.Text
  signatureUrl        String?  @db.Text
  // Invoice Branding assets (additive, optional; blank → Company Profile).
  stampUrl            String?  @db.Text
  qrUrl               String?  @db.Text
  themeColor          String?  @default("#4F7CFF")
  footerText          String?  @db.Text
  designJson          String?  @db.Text // Invoice Designer template config (JSON)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("invoice_settings")
}

// Immutable audit trail for the whole invoice module.
model InvoiceAudit {
  id          Int      @id @default(autoincrement())
  companyId   Int
  entityType  String // Invoice / Customer / Product / Payment / Settings
  entityId    Int?
  invoiceId   Int?
  action      String // CREATED / UPDATED / SENT / PRINTED / EMAILED / PAYMENT_RECORDED / CANCELLED / DELETED
  performedBy String?
  details     String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([invoiceId])
  @@map("invoice_audits")
}

// ═══════════════════════════════════════════════════════════════════════════
//  EMPLOYEE LOAN MANAGEMENT  (relation-less, companyId-scoped — like Invoice*)
//  Deeply integrated with payroll: an Approved/Disbursed/Running loan's monthly
//  EMI is auto-deducted when payroll is (re)computed, its installment ledger is
//  settled idempotently (keyed by payrollId), and outstanding is always DERIVED
//  (principal − Σ paid principal) so repeated recalcs can never drift.
// ═══════════════════════════════════════════════════════════════════════════

model LoanType {
  id                  Int      @id @default(autoincrement())
  companyId           Int
  name                String
  code                String?
  description         String?  @db.Text
  defaultInterestType String   @default("Flat") // Flat / Reducing / None
  defaultInterestRate Float    @default(0)
  maxAmount           Float?   @default(0) // 0 = unlimited
  maxTenureMonths     Int?     @default(0) // 0 = unlimited
  requiresApproval    Boolean  @default(true)
  isSystem            Boolean  @default(false) // seeded defaults
  active              Boolean  @default(true)
  displayOrder        Int      @default(0)
  createdBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, active])
  @@map("loan_types")
}

model Loan {
  id                 Int       @id @default(autoincrement())
  companyId          Int
  branchId           Int?
  employeeId         Int
  employeeName       String    @default("Unknown")
  department         String?
  loanNumber         String
  loanTypeId         Int?
  loanTypeName       String    @default("Loan")
  principalAmount    Float     @default(0)
  interestType       String    @default("Flat") // Flat / Reducing / None
  interestRate       Float     @default(0) // annual %
  totalInterest      Float     @default(0)
  totalPayable       Float     @default(0) // principal + totalInterest
  tenureMonths       Int       @default(1)
  emiAmount          Float     @default(0)
  startDate          String? // yyyy-MM-dd
  endDate            String? // yyyy-MM-dd
  deductionStartMonth String   @default("January")
  deductionStartYear  Int      @default(2026)
  approvalAuthority  String?
  // Reason / purpose the money is requested for (esp. Salary Advances). Distinct
  // from `remarks`, which is internal HR/Finance commentary.
  purpose            String?   @db.Text
  remarks            String?   @db.Text
  attachments        String?   @db.Text // JSON array of {name,data,mimeType}
  // Workflow: Draft → Pending Approval → Approved → (Rejected) → Disbursed →
  // Running → Completed → Closed
  status             String    @default("Draft")
  rejectionReason    String?
  disbursedDate      String?
  requestedBy        String?
  approvedBy         String?
  approvedAt         DateTime?
  closedAt           DateTime?
  // Reminder stages already fired for this loan's next-due EMI (["7","1","overdue"])
  // — the scheduler dedupes against this so a stage never re-sends.
  remindersSent      Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([companyId, loanNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([employeeId])
  @@map("loans")
}

// ── Employee Card Designer templates ─────────────────────────────────────────
// Relation-less, companyId-scoped (no Company FK) so it never touches the maxed
// Company model. Each row is a full portable card design spec (front+back). Built
// -in templates ship in the frontend; only custom/edited ones persist here.
model CardTemplate {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String
  category    String   @default("Custom")
  size        String   @default("CR80")
  orientation String   @default("portrait")
  builtinId   String?  // origin builtin id when duplicated/edited
  spec        Json     // { theme, frontBg, backBg, elements[] }
  isDefault   Boolean  @default(false)
  shared      Boolean  @default(false) // Super-Admin: visible to all companies
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@map("card_templates")
}

// Which Employee ID-card template a company has made ACTIVE. Additive & isolated
// (relation-less, one row per company) so it can point at EITHER a built-in
// template (frontend id, e.g. "glassmorphism") OR a saved custom template
// ("db:<n>") — the card_templates.isDefault flag can only mark custom rows, so
// this table is the single source of truth for the company's active card design.
model CardActiveTemplate {
  id         Int      @id @default(autoincrement())
  companyId  Int      @unique
  templateId String   // built-in id (e.g. "glassmorphism") or "db:<n>" for a custom template
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("card_active_templates")
}

// Visual drag-and-drop Invoice Designer — per-company named canvas layouts.
// Additive & isolated: the classic flow templates (invoice_settings.designJson)
// are untouched; an invoice only renders a canvas layout when one is set active.
model InvoiceLayout {
  id         Int      @id @default(autoincrement())
  companyId  Int
  name       String
  layoutJson String   @db.Text // { page, blocks[] } — the canvas design spec (JSON)
  isDefault  Boolean  @default(false) // the company's ACTIVE canvas layout (0 or 1)
  createdBy  String?
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
  @@map("invoice_layouts")
}

model LoanInstallment {
  id                 Int       @id @default(autoincrement())
  companyId          Int
  loanId             Int
  seq                Int // installment number 1..n
  periodMonth        String // January..December
  periodYear         Int
  dueDate            String? // yyyy-MM-dd
  emiAmount          Float     @default(0)
  principalComponent Float     @default(0)
  interestComponent  Float     @default(0)
  openingBalance     Float     @default(0)
  closingBalance     Float     @default(0)
  status             String    @default("Pending") // Pending / Paid / Skipped
  paidAmount         Float     @default(0)
  paidDate          DateTime?
  paidByPayrollId    Int? // idempotency key: which payroll settled this installment
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([loanId, seq])
  @@index([companyId])
  @@index([loanId])
  @@index([companyId, periodMonth, periodYear])
  @@map("loan_installments")
}

model LoanAudit {
  id          Int      @id @default(autoincrement())
  companyId   Int
  loanId      Int?
  entityType  String   @default("Loan") // Loan / LoanType / Installment
  action      String // CREATED / SUBMITTED / APPROVED / REJECTED / DISBURSED / EMI_DEDUCTED / COMPLETED / CLOSED / UPDATED / DELETED
  fromStatus  String?
  toStatus    String?
  performedBy String?
  details     String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([loanId])
  @@map("loan_audits")
}

// ═══════════════════════════════════════════════════════════════════════════
//  COMPLIANCE MANAGEMENT — statutory filing calendar / due-date tracker.
//  Complements the existing 133-report statutory ENGINE (complianceReport
//  controller) and the ComplianceRecord registration/licence tracker: this adds
//  the periodic FILING obligations (PF/ESI/PT/TDS/GST/LWF/Bonus…) with due dates,
//  status, statutory amounts (derived from payroll) and challan documents.
//  Relation-less, companyId-scoped. Does NOT change payroll or statutory math.
// ═══════════════════════════════════════════════════════════════════════════
model ComplianceFiling {
  id               Int      @id @default(autoincrement())
  companyId        Int
  category         String // PF / ESI / PT / TDS / GST / LWF / Bonus / Gratuity / Factory Act / Labour License / Custom
  title            String
  frequency        String   @default("Monthly") // Monthly / Quarterly / Half-Yearly / Annual / One-Time
  periodLabel      String // "Jul 2026" / "Q1 2026-27" / "FY 2026-27"
  periodMonth      Int      @default(0) // 1..12 for monthly/quarterly anchor; 0 for annual
  periodYear       Int
  dueDate          String // yyyy-MM-dd
  status           String   @default("Pending") // Pending / Filed / Overdue / Waived
  amount           Float?   @default(0) // statutory liability (derived from payroll, editable)
  filedDate        String?
  referenceNumber  String? // challan / ARN / acknowledgement no.
  challanFileData  String?  @db.LongText // uploaded challan (base64)
  challanFileName  String?
  challanMimeType  String?
  versionHistory   Json? // prior challan uploads
  reminderDays     Int      @default(7)
  assignedTo       String?
  remarks          String?  @db.Text
  autoGenerated    Boolean  @default(false)
  // Reminder stages already fired for this filing (["30","15","7","1","overdue"])
  // — the scheduler dedupes against this so a stage never re-sends.
  remindersSent    Json?
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([companyId, category, periodMonth, periodYear])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, dueDate])
  @@map("compliance_filings")
}

model ComplianceFilingAudit {
  id          Int      @id @default(autoincrement())
  companyId   Int
  filingId    Int?
  action      String // CREATED / FILED / UPDATED / WAIVED / DELETED / CHALLAN_UPLOADED / GENERATED
  performedBy String?
  details     String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([filingId])
  @@map("compliance_filing_audits")
}

// Attendance & Salary Deduction Policy — the MASTER calculation config that
// drives every attendance→salary computation (LOP basis, weekly-off/holiday
// pay, absent / half-day / LWP deduction, sandwich policy, OT multiplier).
// Isolated table (plain companyId/branchId Int, no relation) following the
// compliance_* pattern. Every save INSERTS a new row = a new immutable version;
// the highest `version` for a (companyId, branchId) scope is the effective
// policy. branchId = null → company-wide policy; a non-null branchId row is a
// branch-level override that wins for that branch when present. Payroll rows
// stamp the version they were computed under (Payroll.policyVersion), so old
// payslips keep their rules until an explicit recalculation.
model DeductionPolicy {
  id        Int      @id @default(autoincrement())
  companyId Int // parent company id (branch ids are resolved to the parent)
  branchId  Int? // null = company-wide; set = branch-level override
  version   Int      @default(1)
  enabled   Boolean  @default(true)
  config    Json // the full policy object (see POLICY_DEFAULTS in deductionPolicyService)
  reason    String?  @db.Text
  createdBy String?
  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([companyId, branchId])
  @@map("deduction_policy")
}

// Finance & Compliance → Documents. An isolated statutory-document repository
// (Loan/Advance agreements, PF/ESI/PT/LWF challans, GST/TDS returns, Bonus &
// Gratuity registers, custom docs). Deliberately SEPARATE from the generic
// `Document` model so it never mixes with the general Documents module. File is
// stored base64 in fileData (like Document/challans). `history` is an append-only
// JSON audit ([{action, by, at, note}]). `source`/`sourceRef` let future payroll/
// loan/compliance flows auto-file a document here (e.g. a generated PF challan).
model ComplianceDocument {
  id             Int      @id @default(autoincrement())
  companyId      Int
  branchId       Int? // optional branch scope
  name           String
  category       String // Employee Loan Agreement / PF Challan / ESI Challan / …
  complianceType String? // PF / ESI / PT / LWF / GST / TDS / Bonus / Gratuity (optional tag)
  employeeId     Int?
  employeeName   String?
  department     String?
  fileName       String?
  fileData       String?  @db.LongText // base64-encoded uploaded file
  mimeType       String?
  size           String?
  url            String?  @db.Text // optional external link instead of/along with a file
  issueDate      String? // ISO yyyy-mm-dd
  expiryDate     String? // ISO yyyy-mm-dd — drives "Expiring Soon" / "Expired"
  description    String?  @db.Text
  tags           String? // comma-separated tags
  status         String   @default("Pending") // Pending / Verified / Active / Rejected / Expired / Archived
  source         String   @default("Manual") // Manual / Loan / Advance / Payroll / Compliance
  sourceRef      String? // originating record id (loanId / filingId / payrollId) for auto-filed docs
  uploadedBy     String?
  uploadedOn     String?
  verifiedBy     String?
  verifiedOn     String?
  editedBy       String?
  editedOn       String?
  history        Json? // append-only [{action, by, at, note}]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, category])
  @@index([companyId, status])
  @@map("compliance_documents")
}
