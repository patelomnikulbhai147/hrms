generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int                  @id @default(autoincrement())
  name                 String
  email                String               @unique
  username             String               @unique
  passwordHash         String
  role                 String
  companyId            Int?
  branchId             Int? // optional branch a management user is scoped to (for branch-context task assignment)
  accessibleCompanyIds Json                 @default(dbgenerated("(JSON_ARRAY())"))
  status               String               @default("Active")
  avatar               String?              @db.LongText
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  employeeId           Int?
  permissions          Json?
  password             String?
  userId               String?
  lastLoginAt          DateTime?
  auditLogs            AuditLog[]
  passwordResetTokens  PasswordResetToken[]
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  email     String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
}

model LoginAudit {
  id        Int      @id @default(autoincrement())
  userId    Int?
  email     String
  success   Boolean
  reason    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@index([createdAt])
}

model Company {
  id                          Int                 @id @default(autoincrement())
  name                        String
  domain                      String?
  adminName                   String?
  adminEmail                  String?
  phone                       String?
  industry                    String?
  status                      String              @default("Active")
  accountStatus               String              @default("Active")
  paymentStatus               String              @default("Paid")
  plan                        String              @default("Free")
  employeeCount               Int                 @default(0)
  joinDate                    DateTime            @default(now())
  logo                        String?             @db.LongText
  logoImage                   String?             @db.LongText
  isHeadOffice                Boolean             @default(true)
  parentCompanyId             Int?
  offboardingState            Json?
  // First-login onboarding ledger (per head-office company):
  //   { firstLoginCompleted, onboardingCompleted, usedSampleWorkspace,
  //     sampleDataRemoved, choice, completedAt }
  // Stored as JSON (like offboardingState) — barely counts toward the row limit.
  onboardingState             Json?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  basicPercent                Float?
  esicRate                    Float?
  overtimeRate                Float?
  pfRate                      Float?
  primaryColor                String?
  profTaxRate                 Float?
  themeStyle                  String?
  // ── Company branding (managed via Settings → Company Profile & Branding) ──
  shortName                   String?
  tagline                     String?
  website                     String?
  contactEmail                String?
  contactNumber               String?
  address                     String?             @db.Text
  description                 String?             @db.Text
  // ── Company profile identity (Settings → Company Profile & Branding) ──
  companyCode                 String?
  registrationNumber          String?
  panNumber                   String?
  cinNumber                   String?
  city                        String?
  state                       String?
  pincode                     String?
  emailSignature              String?             @db.Text
  // Digital assets (base64 data URLs)
  faviconImage                String?             @db.LongText
  stampImage                  String?             @db.LongText
  digitalSignatureImage       String?             @db.LongText
  activeHrUsers               Int?
  billingAddress              String?
  billingCycle                String?
  billingIncluded             Boolean?
  branchCode                  String?
  branchLicenseActive         Boolean?
  branchLicenseStatus         String?
  branchName                  String?
  branchPortalActive          Boolean?
  branchPriceAddon            Float?
  branchRenewalDate           String?
  companyIndustry             String?
  customDepartments           Json                @default(dbgenerated("(JSON_ARRAY())"))
  departmentMeta              Json?               // rich per-department metadata keyed by name (code/description/status/color/order/head/…)
  departmentTemplateType      String?
  employeeCapacity            Int?
  footerText                  String?
  gstNumber                   String?
  headerText                  String?
  inheritParentDepartments    Boolean?
  licensedEmployeeLimit       Int?
  monthlyBranchCost           Float?
  monthlyUsage                Float?
  payrollLoad                 Float?
  priceMonthly                Float?
  priceYearly                 Float?
  purchasedAdditionalBranches Int?
  signatureText               String?
  storageUsed                 String?
  subscriptionPrice           Float?
  isArchived                  Boolean             @default(false)
  // ── Company Master: extended single-source-of-truth fields (all optional,
  //    additive & backward-compatible — see updates 2026-06) ──────────────────
  // Identity
  legalName                   String?
  displayName                 String?
  tradeName                   String?
  // Contact
  country                     String?
  landline                    String?
  corporateAddress            String?             @db.Text
  // Statutory / registration numbers (cin/gst/pan/registrationNumber already above)
  tanNumber                   String?
  pfCode                      String?
  esiCode                     String?
  ptaxRegistrationNumber      String?
  msmeNumber                  String?
  shopEstablishmentNumber     String?
  labourLicenseNumber         String?
  factoryLicenseNumber        String?
  iecCode                     String?
  isoCertNumber               String?
  fssaiNumber                 String?
  // Management
  founderName                 String?
  coFounderName               String?
  ceoName                     String?
  managingDirector            String?
  directors                   String?             @db.Text
  hrHeadName                  String?
  financeHeadName             String?
  authorizedSignatory         String?
  signatoryDesignation        String?
  // Banking
  bankName                    String?
  bankBranch                  String?
  bankAccountNumber           String?
  ifscCode                    String?
  swiftCode                   String?
  accountHolderName           String?
  upiId                       String?
  // Payroll & statutory cycle
  salaryCycle                 String?
  payrollStartDate            String?
  financialYearStart          String?
  leaveYearStart              String?
  defaultCurrency             String?
  defaultTimeZone             String?
  // Branding extras (headerText/footerText/emailSignature already above)
  motto                       String?
  watermarkText               String?
  // Digital assets (base64 / URL)
  letterheadImage             String?             @db.LongText
  dscImage                    String?             @db.LongText
  gstCertificateImage         String?             @db.LongText
  panCardImage                String?             @db.LongText
  registrationCertImage       String?             @db.LongText
  // ── Company Profile module: extra single-source-of-truth fields (additive &
  //    nullable — see Company Profile module, 2026-06) ─────────────────────────
  // NOTE: these are @db.Text (not VARCHAR) because the Company table is already
  // near MySQL's 65535-byte row limit; TEXT columns barely count toward it.
  companyType                 String?             @db.Text // Private Ltd / LLP / Partnership / Proprietorship / Trust / NGO / Government
  businessCategory            String?             @db.Text
  natureOfBusiness            String?             @db.Text
  dateOfEstablishment         String?             @db.Text
  dateOfIncorporation         String?             @db.Text
  companyStatusLabel          String?             @db.Text // free-text profile status (distinct from SaaS `status`)
  registeredOfficeAddress     String?             @db.Text
  headOfficeAddress           String?             @db.Text
  googleMapLocation           String?             @db.Text
  supportEmail                String?             @db.Text
  hrEmail                     String?             @db.Text
  payrollEmail                String?             @db.Text
  socialLinks                 String?             @db.Text // JSON: { linkedin, twitter, facebook, instagram, youtube }
  paymentTerms                String?             @db.Text
  otherRegistrations          String?             @db.Text // JSON: [{ label, number }]
  reportHeaderImage           String?             @db.LongText
  reportFooterImage           String?             @db.LongText
  watermarkImage              String?             @db.LongText
  attendances                 Attendance[]
  companyContacts             CompanyContact[]
  companyOwners               CompanyOwner[]
  complianceRecords           ComplianceRecord[]
  branches                    Branch[]
  companyPayrolls             CompanyPayroll[]
  documents                   Document[]
  employees                   Employee[]
  leaveRequests               LeaveRequest[]
  paymentRecords              PaymentRecord[]
  payrolls                    Payroll[]
  overtimes                   Overtime[]
  shifts                      Shift[]
  leaveCreditConfigs          LeaveCreditConfig[]
  leaveBalances               LeaveBalance[]
  attendanceSummaries         AttendanceSummary[]
  attendanceDevices           AttendanceDevice[]
}

model Branch {
  id                Int                @id @default(autoincrement())
  companyId         Int
  branchNo          Int?
  branchName        String
  location          String?
  headcount         Int                @default(0)
  status            String             @default("Active")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  isArchived        Boolean            @default(false)
  adminEmail        String?
  adminName         String?
  basicPercent      Float              @default(50)
  branchCode        String?
  email             String?
  employeeCapacity  Int                @default(200)
  esicRate          Float              @default(3.25)
  overtimeRate      Float              @default(1.5)
  pfRate            Float              @default(12)
  phone             String?
  profTaxRate       Float              @default(200)

  // ── Branch offboarding (soft) ──
  // Offboarding NEVER deletes a branch or its employees — it flips `status` to
  // 'Offboarded' + isArchived and records who/why/when here so the decision is
  // queryable and reportable. Attendance, payroll, leave, documents and audit
  // history are all retained by design.
  offboardReason         String?   @db.Text
  offboardEffectiveDate  DateTime?
  offboardedAt           DateTime?
  offboardedBy           String?
  // How employees were handled: 'transfer' | 'archive' | 'inactive'.
  offboardEmployeeAction String?
  // Branch employees were transferred to, when offboardEmployeeAction='transfer'.
  offboardTransferBranchId Int?

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchPayrolls    BranchPayroll[]
  employees         Employee[]
  attendanceDevices AttendanceDevice[]
}

// ── Biometric attendance devices (Phase 1: registry only) ───────────────────
// Registers physical attendance devices per company/branch. This table does NOT
// store attendance punches — the existing `attendance` table remains the single
// source of attendance truth. No device connectivity or sync logic lives here.
model AttendanceDevice {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  branchId            Int?
  deviceName          String
  deviceIp            String?
  port                Int?
  serialNumber        String?
  deviceType          String?
  status              String    @default("ACTIVE") // ACTIVE / INACTIVE
  lastSync            DateTime?
  lastTestAt          DateTime? // Phase 5: last "Test Connection" run
  lastTestStatus      String? // CONNECTED / FAILED
  lastTestResponseMs  Int? // round-trip connect time in ms
  // ── Phase 2: device configuration storage (vendor-driven; no sync yet) ──
  attendanceVendor    String? // vendor name; validated against the attendance_vendors registry (NOT a hardcoded list)
  apiBaseUrl          String?   @db.Text // per-device API base URL (overrides the vendor default; fully configurable)
  corporateId         String? // vendor portal corporate / company id
  apiUsername         String? // vendor API username
  apiPassword         String?   @db.Text // vendor API password — stored ENCRYPTED (AES-256-GCM), never returned in plaintext
  deviceLocation      String? // free-text physical location
  syncEnabled         Boolean   @default(false) // future-sync opt-in flag (no effect yet)
  syncIntervalMinutes Int? // optional per-device sync cadence (config only; no scheduler yet)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  company             Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch              Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([branchId])
  @@map("attendance_devices")
}

// ── Attendance vendor registry ──────────────────────────────────────────────
// Configurable catalog of attendance API vendors. New vendors (eSSL, Matrix,
// ZKTeco, BioMax, …) are added as ROWS here (via the Super-Admin vendor API or a
// seed) — NOT by changing code. Per-vendor defaults (base URL, auth type, free
// settings JSON) live here so nothing vendor-specific is hardcoded in the app.
model AttendanceVendor {
  id             Int      @id @default(autoincrement())
  name           String   @unique // canonical name, e.g. "E-TimeOffice"
  displayName    String? // friendly label, e.g. "E-TimeOffice (Pulpit Mobility)"
  defaultBaseUrl String?  @db.Text // default API base URL (editable; used to prefill a device)
  authType       String? // BASIC / TOKEN / NONE — informational
  isActive       Boolean  @default(true)
  notes          String?  @db.Text
  settings       String?  @db.LongText // arbitrary JSON for vendor-specific options (no code change needed)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("attendance_vendors")
}

// ── Pre-Phase 5 safety: attendance import log ───────────────────────────────
// One row per evaluated punch recording the matching VERDICT. This is an audit
// trail only — it is NOT the attendance table and never marks anyone present.
model AttendanceImportLog {
  id            Int      @id @default(autoincrement())
  companyId     Int
  deviceId      Int?
  biometricCode String?
  employeeId    Int? // resolved Employee.id (null when unmatched)
  employeeCode  String? // snapshot of the business Employee ID, for readability
  employeeName  String? // snapshot
  punchTime     String?
  status        String // MATCHED / NO_BIOMETRIC_CODE / UNMATCHED / DUPLICATE_CODE
  message       String?  @db.Text
  importDate    DateTime @default(now())

  @@index([companyId])
  @@index([status])
  @@map("attendance_import_logs")
}

// ── Pre-Phase 5 safety: unmatched attendance queue ──────────────────────────
// Punches that could NOT be safely matched (blank code / no match / duplicate
// code) are parked here for an admin to resolve. No attendance is created.
model UnmatchedAttendance {
  id            Int      @id @default(autoincrement())
  companyId     Int
  deviceId      Int?
  biometricCode String?
  punchTime     String?
  reason        String // NO_BIOMETRIC_CODE / UNMATCHED / DUPLICATE_CODE
  message       String?  @db.Text
  rawPayload    String?  @db.Text
  resolved      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
  @@index([resolved])
  @@map("unmatched_attendance_queue")
}

// ── E-TimeOffice pull-API integration (Phase 5: live sync) ──────────────────
// Per-company connection to the E-TimeOffice attendance cloud. The pull sync
// reads punches via the documented REST API and upserts them into the existing
// `attendance` table (single source of truth) — every punch routed through
// attendanceMatcher.resolvePunch so RULES 1–5 stay enforced. Credentials are
// stored ENCRYPTED (AES-256-GCM via secretCrypto) and never returned plaintext.
// Relation-less (companyId Int only) — mirrors AttendanceImportLog so the large
// Company model is untouched.
model EtimeConnection {
  id                  Int       @id @default(autoincrement())
  companyId           Int       @unique
  enabled             Boolean   @default(false)
  apiBaseUrl          String    @default("https://api.etimeoffice.com/api/")
  corporateId         String?
  apiUsername         String?
  apiPassword         String?   @db.Text // AES-256-GCM ciphertext ("enc:v1:..."); never returned plaintext
  empCode             String    @default("ALL") // Empcode filter for the pull (ALL = every employee)
  // ── Merged from the retired "Attendance Devices" module (single source of truth) ──
  vendor              String    @default("E-TimeOffice") // validated against the attendance_vendors registry
  branchId            Int? // optional branch this connection's devices belong to
  deviceSerialNumber  String? // optional device serial (metadata)
  deviceLocation      String? // optional physical location (metadata)
  syncIntervalMinutes Int       @default(30)
  syncWindowDays      Int       @default(2) // rolling look-back for the IN/OUT pull (idempotent upsert)
  lastCursor          String? // MaxRecord cursor for incremental LastRecord pulls (future use)
  lastSyncAt          DateTime?
  lastSyncStatus      String? // SUCCESS / PARTIAL / FAILED
  connectionStatus    String    @default("not_connected") // not_connected / connected / error
  lastTestAt          DateTime?
  lastTestStatus      String? // CONNECTED / FAILED
  lastTestResponseMs  Int?
  lastError           String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("etimeoffice_connections")
}

// One row per sync RUN (manual or scheduled) — the run-level log the spec asks
// for (start/end, imported/failed/duplicates, status, error). Per-PUNCH verdicts
// continue to use the existing attendance_import_logs table.
model AttendanceSyncLog {
  id           Int       @id @default(autoincrement())
  companyId    Int
  source       String    @default("E-TimeOffice")
  trigger      String    @default("manual") // manual / scheduler
  status       String    @default("RUNNING") // RUNNING / SUCCESS / PARTIAL / FAILED
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  durationMs   Int?
  fetched      Int       @default(0)
  imported     Int       @default(0)
  updated      Int       @default(0)
  skipped      Int       @default(0)
  duplicates   Int       @default(0)
  unmatched    Int       @default(0)
  failed       Int       @default(0)
  httpStatus   Int?
  windowFrom   String?
  windowTo     String?
  errorMessage String?   @db.Text
  createdAt    DateTime  @default(now())

  @@index([companyId])
  @@index([status])
  @@map("attendance_sync_logs")
}

// ── Bonus Management — separate bonus transaction system ─────────────────────
// Deliberately decoupled from the Employee table: bonus changes yearly, supports
// multiple types, must keep full audit history, and integrates with payroll.

// Per-company, per-financial-year bonus rules (template the cycles use).
model BonusConfiguration {
  id               Int      @id @default(autoincrement())
  companyId        Int
  bonusType        String // Statutory / Festival / Performance / Ex-Gratia / Special
  financialYear    String // e.g. "2024-2025"
  minBonusPercent  Float    @default(8.33)
  maxBonusPercent  Float    @default(20)
  salaryCeiling    Float? // statutory wage ceiling (e.g. 21000)
  minWorkingDays   Int      @default(30)
  includeLeaveDays Boolean  @default(true)
  includeOvertime  Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, financialYear])
  @@map("bonus_configurations")
}

// A bonus run for a company / FY / type. Drives the approval workflow.
model BonusCycle {
  id            Int       @id @default(autoincrement())
  companyId     Int
  configId      Int?
  name          String
  bonusType     String
  financialYear String
  status        String    @default("Draft") // Draft / Calculated / Approved / Paid / Cancelled
  totalAmount   Float     @default(0)
  employeeCount Int       @default(0)
  generatedBy   Int?
  approvedBy    Int?
  releasedBy    Int?
  generatedAt   DateTime?
  approvedAt    DateTime?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId])
  @@index([status])
  @@map("bonus_cycles")
}

// Per-employee eligibility within a cycle.
model BonusEligibility {
  id                Int      @id @default(autoincrement())
  cycleId           Int
  companyId         Int
  employeeId        Int
  workingDays       Int      @default(0)
  eligibilityStatus String   @default("Pending Verification") // Eligible / Not Eligible / Pending Verification
  reason            String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([cycleId])
  @@index([companyId])
  @@map("bonus_eligibility")
}

// Per-employee calculated bonus within a cycle (supports manual override).
model BonusCalculation {
  id               Int      @id @default(autoincrement())
  cycleId          Int
  companyId        Int
  employeeId       Int
  eligibleSalary   Float    @default(0)
  bonusPercent     Float    @default(0)
  bonusAmount      Float    @default(0)
  isManualOverride Boolean  @default(false)
  overrideBy       Int?
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([cycleId])
  @@index([companyId])
  @@map("bonus_calculations")
}

// Payment records (release stage).
model BonusPayment {
  id          Int       @id @default(autoincrement())
  cycleId     Int
  companyId   Int
  employeeId  Int
  amount      Float     @default(0)
  paymentDate DateTime?
  paymentMode String? // Bank Transfer / Cash / Cheque
  reference   String?
  status      String    @default("Pending") // Pending / Paid / Failed
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([cycleId])
  @@index([companyId])
  @@map("bonus_payments")
}

// Immutable audit trail for every bonus action.
model BonusAuditLog {
  id              Int      @id @default(autoincrement())
  companyId       Int
  cycleId         Int?
  entityType      String // CONFIGURATION / CYCLE / ELIGIBILITY / CALCULATION / PAYMENT
  entityId        Int?
  action          String // CREATE / UPDATE / DELETE / GENERATE / APPROVE / RELEASE / CANCEL
  performedBy     Int?
  performedByName String?
  details         String?  @db.Text
  createdAt       DateTime @default(now())

  @@index([companyId])
  @@index([cycleId])
  @@map("bonus_audit_logs")
}

// ── Location master list (custom states/cities saved for reuse) ──────────────
// Backs the creatable State/City comboboxes: custom entries are stored here so
// they appear in the dropdown for everyone next time. State & City are
// independent — there is intentionally no state→city relationship.
model LocationMaster {
  id        Int      @id @default(autoincrement())
  type      String // 'city' | 'state'
  name      String
  createdAt DateTime @default(now())

  @@unique([type, name])
  @@index([type])
  @@map("location_masters")
}

// ── Geography masters: Country → State → City ───────────────────────────────
// Relational reference data for the Employee Personal-Info location fields and the
// Nationality field. Seeded from the bundled dataset (India's states/UTs + cities,
// and the international country list) and extended at runtime with custom entries:
// custom cities are linked to their state, so a state's city dropdown only ever
// shows that state's cities. `isCustom` marks user-added rows. Existing free-text
// state/city/nationality values on employees are unaffected (no FK on Employee).
model CountryMaster {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  isCustom  Boolean       @default(false)
  createdAt DateTime      @default(now())
  states    StateMaster[]

  @@map("country_masters")
}

model StateMaster {
  id        Int           @id @default(autoincrement())
  name      String
  countryId Int
  country   CountryMaster @relation(fields: [countryId], references: [id], onDelete: Cascade)
  isCustom  Boolean       @default(false)
  createdAt DateTime      @default(now())
  cities    CityMaster[]

  @@unique([countryId, name])
  @@index([countryId])
  @@map("state_masters")
}

model CityMaster {
  id        Int         @id @default(autoincrement())
  name      String
  stateId   Int
  state     StateMaster @relation(fields: [stateId], references: [id], onDelete: Cascade)
  isCustom  Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@unique([stateId, name])
  @@index([stateId])
  @@map("city_masters")
}

// ── Government compliance report audit trail ─────────────────────────────────
// Every generate/download of a statutory report is logged here (who, what,
// filters used, when) for the compliance audit trail.
model ComplianceReportLog {
  id              Int      @id @default(autoincrement())
  companyId       Int
  reportKey       String
  reportName      String
  action          String // GENERATE / DOWNLOAD
  format          String? // PDF / EXCEL (for downloads)
  filters         String?  @db.Text
  rowCount        Int      @default(0)
  performedBy     Int?
  performedByName String?
  createdAt       DateTime @default(now())

  @@index([companyId])
  @@index([reportKey])
  @@map("compliance_report_logs")
}

// ── EPFO ECR generation history (isolated PF report) ─────────────────────────
// Append-only log of every generated Electronic Challan cum Return, with the
// exact file body stored so it can be re-downloaded. Isolated scalar companyId
// (no relation) — additive; touches no existing model.
model EcrHistory {
  id              Int      @id @default(autoincrement())
  companyId       Int
  companyName     String?
  branchId        Int?
  branchName      String?
  month           String
  year            Int
  department      String?
  employeeStatus  String?
  employeeCount   Int      @default(0) // eligible members written to the file
  totalEmployees  Int      @default(0) // total considered for the period
  fileName        String?
  fileContent     String?  @db.LongText
  generatedBy     String?
  generatedByName String?
  createdAt       DateTime @default(now())

  @@index([companyId])
  @@map("ecr_history")
}

// ── Raw device push log (Phase 6: ADMS-style receiver, DEBUG only) ───────────
// Captures every inbound request from an attendance device exactly as received.
// This is a debug/inspection table — it is NOT the attendance table and is never
// used to mark anyone present. No FK to a device (the pusher may be unidentified).
model DevicePushLog {
  id               Int      @id @default(autoincrement())
  receivedAt       DateTime @default(now())
  deviceId         Int?
  deviceIp         String?
  method           String?
  path             String?  @db.Text
  contentType      String?
  headers          String?  @db.LongText
  query            String?  @db.Text
  rawPayload       String?  @db.LongText
  userId           String?
  biometricId      String?
  punchTime        String?
  punchType        String?
  // Phase 7A — eTimeOffice XML-over-TCP handshake fields + the exact ACK we sent
  terminalType     String?
  deviceUid        String?
  deviceSerialNo   String?
  terminalId       String?
  responsePayload  String?  @db.LongText
  processingResult String? // e.g. "HANDSHAKE_ACK_v1 (no attendance created)"
  createdAt        DateTime @default(now())

  @@index([receivedAt])
  @@map("device_push_logs")
}

model Employee {
  id                  Int                 @id @default(autoincrement())
  employeeId          String              @unique
  legacyEmployeeId    String?
  companyId           Int
  branchId            Int?
  shiftId             Int?
  biometricId         String?             @db.VarChar(50)
  name                String
  firstName           String?
  lastName            String?
  email               String
  phone               String?
  department          String
  designation         String
  role                String              @default("Staff")
  status              String              @default("Active")
  joinDate            DateTime
  exitDate            DateTime?
  exitReason          String?
  location            String?
  avatar              String?             @db.LongText
  salary              Float               @default(0)
  manager             String?
  pan                 String?
  aadhaar             String?
  uan                 String?
  pfNumber            String?
  esiNumber           String?
  wcPolicyNumber      String?             @db.VarChar(100) // Workmen Compensation (WC) insurance policy no. — optional
  bankName            String?
  accountNumber       String?
  ifsc                String?
  // ── IFSC-resolved bank details (auto-fetched from the IFSC code) ──
  accountHolderName   String?
  bankBranch          String?
  bankAddress         String?             @db.Text
  bankCity            String?
  bankDistrict        String?
  bankState           String?
  offboardingState    Json?
  employmentHistory   Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  documents           Json?
  aadhaarName         String?
  aadhaarUpload       String?             @db.LongText
  branchLocation      String?
  category            String?
  dob                 String?
  emergencyContact    String?
  employmentType      String?
  fatherSpouseName    String?
  gender              String?
  maritalStatus       String?
  middleName          String?
  nationality         String?
  state               String? // employee home state (Personal Info)
  city                String? // employee home city (dependent on state)
  panUpload           String?             @db.LongText
  permanentAddress    String?             @db.Text
  photoUpload         String?             @db.LongText
  presentAddress      String?             @db.Text
  relationType        String?
  signatureUpload     String?             @db.LongText
  // Extended HR employment assignment captured at temp-employee approval (grade,
  // level, confirmation date, probation, wage/skill category, PF/ESI/PT, bonus
  // eligibility, weekly-off, attendance/leave/holiday policy choices). A RECORD
  // only — payroll/attendance/leave engines read their own config, untouched.
  employmentMeta      Json?
  // ── Bonus configuration (per-employee, managed from Employee + Payroll) ──
  // Recurring bonus rule that flows into payroll. One-time bonuses (festival /
  // performance) live in the EmployeeBonus table instead.
  bonusApplicable     Boolean             @default(false)
  bonusType           String? // Monthly / Quarterly / Half-Yearly / Yearly / Performance / Festival / Custom
  bonusCalcMethod     String? // "Fixed Amount" | "Percentage of Salary"
  bonusValue          Float? // flat amount, or percent of salary, per bonusCalcMethod
  bonusEffectiveDate  DateTime?
  bonusEndDate        DateTime?
  bonusNotes          String?             @db.Text
  attendance          Attendance[]
  branch              Branch?             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  company             Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shift               Shift?              @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  leaveRequests       LeaveRequest[]
  payroll             Payroll[]
  overtimes           Overtime[]
  leaveBalances       LeaveBalance[]
  attendanceSummaries AttendanceSummary[]
  employeeBonuses     EmployeeBonus[]
  deployments         Deployment[]
}

// ── Temporary Employee (Quick Registration) ─────────────────────────────────
// Fully ADDITIVE & ISOLATED: a temporary/onboarding employee created by HR with
// only Name + Mobile + Branch. Lives in its own table (no relations to Employee/
// payroll/attendance) so existing flows are never affected. On conversion a real
// Employee row is created and this record is marked Converted (linked, preserved).
// companyId/branchId are plain scalars (no FK) to keep Company/Branch untouched.
model TemporaryEmployee {
  id                    Int       @id @default(autoincrement())
  tempEmployeeId        String    @unique // e.g. VE-TEMP-000001
  companyId             Int
  branchId              Int?
  branchLocation        String?
  name                  String
  mobile                String    @unique // one mobile = one employee identity
  department            String?
  designation           String?
  email                 String?
  status                String    @default("Pending Profile") // Pending Profile | Partially Completed | Pending Approval | Changes Requested | Converted | Rejected
  // Self-onboarding profile fields (completed later by HR or the employee)
  dob                   String?
  gender                String?
  fatherSpouseName      String?
  aadhaar               String?
  pan                   String?
  bankName              String?
  accountNumber         String?
  ifsc                  String?
  presentAddress        String?   @db.Text
  permanentAddress      String?   @db.Text
  nominee               Json?
  emergencyContact      String?
  education             Json?
  experience            Json?
  photoUpload           String?   @db.LongText
  documents             Json?
  // Expanded EMPLOYEE-owned personal data with no dedicated scalar column
  // (name parts, marital status, nationality, blood group, alternate mobile,
  // structured present/permanent address, extra identity/banking fields).
  selfProfile           Json?
  profileCompletion     Int       @default(0)
  convertedEmployeeId   Int? // real Employee.id after conversion
  convertedEmployeeCode String? // official employeeId after conversion
  convertedAt           DateTime?
  rejectedReason        String?
  // Approval-workflow audit trail (a temp can never be activated directly)
  submittedBy           String?
  submittedAt           DateTime?
  approvedBy            String?
  approvedAt            DateTime?
  rejectedBy            String?
  rejectedAt            DateTime?
  changeRequestNote     String?   @db.Text
  changeRequestBy       String?
  changeRequestAt       DateTime?
  createdBy             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([companyId])
  @@index([branchId])
  @@index([status])
}

// ── Per-employee bonus ledger — the new bonus model ──────────────────────────
// Every bonus that touches an employee: recurring config snapshots applied each
// payroll cycle, and one-time festival/performance bonuses issued from Payroll.
// Keeps full history; generic AuditLog records create/update/delete/apply/paid.
model EmployeeBonus {
  id             Int       @id @default(autoincrement())
  companyId      Int
  employeeId     Int
  source         String    @default("employee") // "employee" (recurring) | "payroll" (one-time)
  bonusType      String // Monthly / Quarterly / Half-Yearly / Yearly / Performance / Festival / Custom
  calcMethod     String? // "Fixed Amount" | "Percentage of Salary"
  amount         Float     @default(0) // resolved bonus amount in currency
  percent        Float? // when calcMethod is percentage
  reason         String?   @db.Text // performance reason / festival name
  approvedBy     Int?
  approvedByName String?
  approvalDate   DateTime?
  effectiveDate  DateTime?
  endDate        DateTime?
  status         String    @default("Active") // Active / Paid / Cancelled
  payrollMonth   String? // month it was applied/paid through payroll
  payrollYear    Int?
  notes          String?   @db.Text
  createdBy      Int?
  createdByName  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([employeeId])
  @@index([payrollMonth, payrollYear])
  @@map("employee_bonuses")
}

model Payroll {
  id               Int       @id @default(autoincrement())
  companyId        Int       @default(1)
  employeeId       Int
  employeeName     String    @default("Unknown")
  department       String    @default("General")
  month            String
  year             Int       @default(2026)
  basicSalary      Float     @default(0)
  allowances       Float     @default(0)
  deductions       Float     @default(0)
  netSalary        Float     @default(0)
  payrollStatus    String    @default("draft")
  paymentStatus    String    @default("pending")
  payslipGenerated Boolean   @default(false)
  // ── Attendance-derived figures (single source of truth = AttendanceSummary) ──
  presentDays      Float     @default(0)
  clDays           Float     @default(0)
  plDays           Float     @default(0)
  slDays           Float     @default(0)
  lwpDays          Float     @default(0)
  halfDays         Float     @default(0)
  otHours          Float     @default(0)
  payableDays      Float     @default(0)
  // Full attendance snapshot mirrored from the AttendanceSummary at sync time, so
  // the payslip / salary register / reports can show the exact synced figures
  // (working/weekly-off/holiday) WITHOUT re-deriving attendance in payroll.
  workingDays      Float     @default(0)
  weeklyOffDays    Float     @default(0)
  holidayDays      Float     @default(0)
  // Set when attendance was written to payroll via Attendance Synchronization.
  // Null → this month has NOT been synchronized (salary actions stay blocked).
  attendanceSyncedAt DateTime?
  attendanceSource String?
  isOutdated       Boolean   @default(false)
  summarySyncedAt  DateTime?
  processedOn      String?
  paymentDate      String?
  dueDate          String?
  paymentMethod    String?
  paidBy           String?
  bonus            Float?
  // Overtime surfaced as its own payroll line (the amount is still part of
  // `allowances` for net-salary math; this column lets the UI show it separately
  // without double-counting). Bonus is folded INTO netSalary (Basic + Allowances
  // + Overtime + Bonus − Deductions).
  overtime         Float?    @default(0)
  tax              Float?
  // Loan EMI auto-deducted from this payroll (part of `deductions`; surfaced
  // separately so the payslip can show a Loan EMI line without polluting the
  // "Other deductions" bucket). Written by the loan→payroll settle hook.
  loanDeduction    Float?    @default(0)
  // Version of the Attendance & Salary Deduction Policy this row was computed
  // under (DeductionPolicy.version). Null = pre-policy / legacy record. Existing
  // records keep their version until the user explicitly recalculates, so a
  // payslip always reflects the rules it was generated with.
  policyVersion    Int?
  notes            String?
  companyPayrollId String?
  branchPayrollId  String?
  // ── Payslip lifecycle tracking (audit history) ──
  payslipFileName  String?
  generatedAt      DateTime?
  downloadedAt     DateTime?
  downloadCount    Int       @default(0)
  emailSentAt      DateTime?
  approvedAt       DateTime?
  approvedBy       String?
  lockedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year, companyId])
}

model CompanyPayroll {
  id                 Int      @id @default(autoincrement())
  companyId          Int
  payrollMonth       String   @map("payroll_month")
  payrollYear        Int      @map("payroll_year")
  totalEmployees     Int      @map("total_employees")
  processedEmployees Int      @map("processed_employees")
  pendingEmployees   Int      @map("pending_employees")
  totalAmount        Float    @map("total_amount")
  status             String   @default("Pending")
  generatedBy        String   @map("generated_by")
  generatedAt        DateTime @default(now()) @map("generated_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, payrollMonth, payrollYear])
}

model BranchPayroll {
  id                 Int      @id @default(autoincrement())
  branchId           Int      @map("branch_id")
  companyId          Int      @map("company_id")
  payrollMonth       String   @map("payroll_month")
  payrollYear        Int      @map("payroll_year")
  totalEmployees     Int      @map("total_employees")
  processedEmployees Int      @map("processed_employees")
  pendingEmployees   Int      @map("pending_employees")
  totalAmount        Float    @map("total_amount")
  status             String   @default("Pending")
  generatedBy        String   @map("generated_by")
  generatedAt        DateTime @default(now()) @map("generated_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  branch             Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, payrollMonth, payrollYear])
}

model Attendance {
  id           Int      @id @default(autoincrement())
  companyId    Int      @default(1)
  employeeId   Int
  employeeName String   @default("Unknown")
  department   String   @default("General")
  branch       String?
  date         String   @default("2026-05-20")
  clockIn      String   @default("09:00")
  clockOut     String   @default("18:00")
  status       String   @default("Present")
  hoursWorked  Float    @default(8)
  flags        Json     @default(dbgenerated("(JSON_ARRAY())"))
  leaveType    String?
  shift        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Single source of truth: exactly ONE attendance row per employee per date.
  // Prevents the duplicate rows that caused edits to "revert" after refresh.
  @@unique([employeeId, date])
}

