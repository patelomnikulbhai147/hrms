// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  COMPLIANCE MANAGEMENT â€” statutory filing calendar / due-date tracker.
//  Complements the existing 133-report statutory ENGINE (complianceReport
//  controller) and the ComplianceRecord registration/licence tracker: this adds
//  the periodic FILING obligations (PF/ESI/PT/TDS/GST/LWF/Bonusâ€¦) with due dates,
//  status, statutory amounts (derived from payroll) and challan documents.
//  Relation-less, companyId-scoped. Does NOT change payroll or statutory math.
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
model ComplianceFiling {
  id              Int      @id @default(autoincrement())
  companyId       Int
  category        String // PF / ESI / PT / TDS / GST / LWF / Bonus / Gratuity / Factory Act / Labour License / Custom
  title           String
  frequency       String   @default("Monthly") // Monthly / Quarterly / Half-Yearly / Annual / One-Time
  periodLabel     String // "Jul 2026" / "Q1 2026-27" / "FY 2026-27"
  periodMonth     Int      @default(0) // 1..12 for monthly/quarterly anchor; 0 for annual
  periodYear      Int
  dueDate         String // yyyy-MM-dd
  status          String   @default("Pending") // Pending / Filed / Overdue / Waived
  amount          Float?   @default(0) // statutory liability (derived from payroll, editable)
  filedDate       String?
  referenceNumber String? // challan / ARN / acknowledgement no.
  challanFileData String?  @db.LongText // uploaded challan (base64)
  challanFileName String?
  challanMimeType String?
  versionHistory  Json? // prior challan uploads
  reminderDays    Int      @default(7)
  assignedTo      String?
  remarks         String?  @db.Text
  autoGenerated   Boolean  @default(false)
  // Reminder stages already fired for this filing (["30","15","7","1","overdue"])
  // â€” the scheduler dedupes against this so a stage never re-sends.
  remindersSent   Json?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, category, periodMonth, periodYear])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, dueDate])
  @@map("compliance_filings")
}

model ComplianceFilingAudit {
  id          Int      @id @default(autoincrement())
  companyId   Int
  filingId    Int?
  action      String // CREATED / FILED / UPDATED / WAIVED / DELETED / CHALLAN_UPLOADED / GENERATED
  performedBy String?
  details     String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([filingId])
  @@map("compliance_filing_audits")
}

// Attendance & Salary Deduction Policy â€” the MASTER calculation config that
// drives every attendanceâ†’salary computation (LOP basis, weekly-off/holiday
// pay, absent / half-day / LWP deduction, sandwich policy, OT multiplier).
// Isolated table (plain companyId/branchId Int, no relation) following the
// compliance_* pattern. Every save INSERTS a new row = a new immutable version;
// the highest `version` for a (companyId, branchId) scope is the effective
// policy. branchId = null â†’ company-wide policy; a non-null branchId row is a
// branch-level override that wins for that branch when present. Payroll rows
// stamp the version they were computed under (Payroll.policyVersion), so old
// payslips keep their rules until an explicit recalculation.
model DeductionPolicy {
  id        Int      @id @default(autoincrement())
  companyId Int // parent company id (branch ids are resolved to the parent)
  branchId  Int? // null = company-wide; set = branch-level override
  version   Int      @default(1)
  enabled   Boolean  @default(true)
  config    Json // the full policy object (see POLICY_DEFAULTS in deductionPolicyService)
  reason    String?  @db.Text
  createdBy String?
  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([companyId, branchId])
  @@map("deduction_policy")
}

// Finance & Compliance â†’ Documents. An isolated statutory-document repository
// (Loan/Advance agreements, PF/ESI/PT/LWF challans, GST/TDS returns, Bonus &
// Gratuity registers, custom docs). Deliberately SEPARATE from the generic
// `Document` model so it never mixes with the general Documents module. File is
// stored base64 in fileData (like Document/challans). `history` is an append-only
// JSON audit ([{action, by, at, note}]). `source`/`sourceRef` let future payroll/
// loan/compliance flows auto-file a document here (e.g. a generated PF challan).
model ComplianceDocument {
  id             Int      @id @default(autoincrement())
  companyId      Int
  branchId       Int? // optional branch scope
  name           String
  category       String // Employee Loan Agreement / PF Challan / ESI Challan / â€¦
  complianceType String? // PF / ESI / PT / LWF / GST / TDS / Bonus / Gratuity (optional tag)
  employeeId     Int?
  employeeName   String?
  department     String?
  fileName       String?
  fileData       String?  @db.LongText // base64-encoded uploaded file
  mimeType       String?
  size           String?
  url            String?  @db.Text // optional external link instead of/along with a file
  issueDate      String? // ISO yyyy-mm-dd
  expiryDate     String? // ISO yyyy-mm-dd â€” drives "Expiring Soon" / "Expired"
  description    String?  @db.Text
  tags           String? // comma-separated tags
  status         String   @default("Pending") // Pending / Verified / Active / Rejected / Expired / Archived
  source         String   @default("Manual") // Manual / Loan / Advance / Payroll / Compliance
  sourceRef      String? // originating record id (loanId / filingId / payrollId) for auto-filed docs
  uploadedBy     String?
  uploadedOn     String?
  verifiedBy     String?
  verifiedOn     String?
  editedBy       String?
  editedOn       String?
  history        Json? // append-only [{action, by, at, note}]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, category])
  @@index([companyId, status])
  @@map("compliance_documents")
}

// Leave-type master â€” WHICH leave types a company offers, and WHO is eligible.
//
// Gender-based eligibility is a business rule, not a UI preference: a male
// employee must not be able to apply for Maternity Leave through the form OR by
// posting to the API directly. Storing it here (rather than hardcoding a list in
// the page) means HR configures it, branches inherit it, and the backend can
// enforce the same rule the form displays.
//
// eligibleGender: 'All' | 'Male' | 'Female'. Anything else is treated as 'All'.
// A company row overrides the seeded default for that code; codes not present in
// the table fall back to LEAVE_TYPE_DEFAULTS in leaveEligibilityService.
model LeaveTypePolicy {
  id             Int      @id @default(autoincrement())
  companyId      Int // parent company id (branch ids resolve to the parent)
  code           String // stable key: annual, casual, sick, maternity, paternityâ€¦
  label          String // what HR sees and what the request stores
  eligibleGender String   @default("All")
  enabled        Boolean  @default(true)
  sortOrder      Int      @default(0)
  isSystem       Boolean  @default(true) // seeded default vs HR-created
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@map("leave_type_policy")
}

// â”€â”€ Multi-Tenant Bank Verification Platform (BYO API Architecture) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Stores company-specific bank verification provider settings with encrypted credentials.
model CompanyBankVerificationSettings {
  id                      Int       @id @default(autoincrement())
  companyId               Int       @unique
  verificationMode        String    @default("Manual") // Manual / API Verification
  provider                String    @default("RazorpayX") // RazorpayX / Cashfree / Decentro / Signzy / SurePass / HyperVerge / Setu / Custom Provider
  credentialSource        String    @default("Global") // Global / Company
  authenticationType      String    @default("Bearer Token") // Bearer Token / API Key / API Key + Secret / OAuth2 Client Credentials / Basic Authentication
  apiBaseUrl              String?   @db.Text
  apiKeyEncrypted         String?   @db.Text
  apiSecretEncrypted      String?   @db.Text
  bearerTokenEncrypted    String?   @db.Text
  clientIdEncrypted       String?   @db.Text
  clientSecretEncrypted   String?   @db.Text
  webhookSecretEncrypted  String?   @db.Text
  environment             String    @default("Sandbox") // Sandbox / Production
  isEnabled               Boolean   @default(false)
  lastConnectionStatus    String? // connected / failed / invalid_token / unreachable
  lastConnectionCheckedAt DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@map("company_bank_verification_settings")
}

// Immutable audit log of every bank account verification request per tenant.
// Rows are never updated or deleted â€” one row per verification attempt, forever.
//
// The columns below the original block are the enterprise verification record:
// every field the provider returns is extracted into a typed column AND kept
// verbatim in `rawResponse`, so a field Cashfree adds tomorrow is still stored
// without a schema change. `rawRequest` is the outbound payload with credentials
// stripped â€” client secrets/keys/tokens are never written here.
model BankVerificationAuditLog {
  id                  Int      @id @default(autoincrement())
  companyId           Int
  provider            String
  verificationMode    String   @default("API Verification")
  ifsc                String?
  accountNumberMasked String?
  employeeName        String?
  referenceId         String?
  requestTime         DateTime @default(now())
  responseTimeMs      Int?
  status              String // VERIFIED / FAILED / VERIFICATION_INCOMPLETE / MANUAL_OVERRIDE / RATE_LIMITED / ERROR
  errorMessage        String?  @db.Text
  createdAt           DateTime @default(now())

  // â”€â”€ Who / where (Â§1, Â§2, Â§7) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  employeeId     Int?
  employeeCode   String? @db.VarChar(64)
  branchId       Int?
  branchName     String? @db.VarChar(191)
  department     String? @db.VarChar(191)
  designation    String? @db.VarChar(191)
  employeeEmail  String? @db.VarChar(191)
  employeePhone  String? @db.VarChar(32)
  verifiedById   Int?
  verifiedByName String? @db.VarChar(191)
  verifiedByRole String? @db.VarChar(64)

  // â”€â”€ Provider identity & environment (Â§1, Â§6) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  environment        String? @db.VarChar(32) // Production / Sandbox
  verificationId     String? @db.VarChar(191) // provider-side verification id
  requestId          String? @db.VarChar(191) // provider-side request/trace id
  verificationSource String? @db.VarChar(64)

  // â”€â”€ Bank response payload (Â§3) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  accountHolderName   String? @db.VarChar(191)
  bankName            String? @db.VarChar(191)
  branchName2         String? @db.VarChar(191) // bank branch (distinct from company branch)
  branchAddress       String? @db.Text
  city                String? @db.VarChar(128)
  district            String? @db.VarChar(128)
  state               String? @db.VarChar(128)
  micr                String? @db.VarChar(32)
  swift               String? @db.VarChar(32)
  utr                 String? @db.VarChar(64)
  accountStatus       String? @db.VarChar(64)
  accountStatusCode   String? @db.VarChar(64)
  verificationMessage String? @db.Text

  // â”€â”€ Name match (Â§4) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  enteredName     String? @db.VarChar(191)
  nameMatchResult String? @db.VarChar(32) // EXACT_MATCH / PARTIAL_MATCH / MISMATCH
  nameMatchScore  Int? // 0â€“100
  nameMatchSource String? @db.VarChar(32) // PROVIDER / COMPUTED

  // â”€â”€ API log (Â§6, Â§10) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  requestTimestamp  DateTime?
  responseTimestamp DateTime?
  httpStatus        Int?
  retryCount        Int       @default(0)
  rawRequest        Json? // credentials stripped
  rawResponse       Json? // verbatim provider body â€” future fields included

  // â”€â”€ Billing (Â§6, Â§7) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  verificationCost    Int?
  walletBalanceBefore Int?
  walletBalanceAfter  Int?

  @@index([companyId])
  @@index([referenceId])
  @@index([employeeId])
  @@index([companyId, status])
  @@index([createdAt])
  @@map("bank_verification_audit_logs")
}

// â”€â”€ Enterprise Bank Verification Credit Management System â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Stores verification credit balance, usage, and expiry per tenant and service type.
model VerificationCreditWallet {
  id               Int       @id @default(autoincrement())
  companyId        Int
  serviceType      String    @default("BANK_VERIFICATION") // BANK_VERIFICATION, PAN, GST, AADHAAR, UAN, DL, PASSPORT...
  totalCredits     Int       @default(0)
  usedCredits      Int       @default(0)
  remainingCredits Int       @default(0)
  expiredCredits   Int       @default(0)
  expiryDate       DateTime?
  status           String    @default("Active") // Active / Suspended / Exhausted
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([companyId, serviceType])
  @@index([companyId])
  @@map("verification_credit_wallet")
}

// Immutable ledger of all credit allocations, additions, deductions, resets, and verifications.
model VerificationCreditTransaction {
  id              Int      @id @default(autoincrement())
  transactionId   String   @unique // stable ledger tx ID (e.g. TX-CR-20260727-0001)
  companyId       Int
  employeeId      Int?
  verificationId  String? // reference to verification audit log or external ref
  serviceType     String   @default("BANK_VERIFICATION")
  transactionType String // Credit / Debit / Allocation / Reset / Expired / Addition / Deduction
  credits         Int // number of credits added or deducted
  openingBalance  Int
  closingBalance  Int
  provider        String   @default("ZeniaHR Verification Gateway")
  referenceId     String?
  remarks         String?  @db.Text
  createdBy       String? // Super Admin or System
  verifiedBy      String? // Employee / HR who triggered verification
  createdAt       DateTime @default(now())

  @@index([companyId])
  @@index([transactionId])
  @@index([createdAt])
  @@map("verification_credit_transactions")
}

// â”€â”€ Payment Gateway (Cashfree PG) â€” reusable self-service payment spine â”€â”€â”€â”€â”€â”€
// One row per merchant order. Tenant identity (companyId/branchId/userId) is
// written ONCE at order creation from the authenticated session and is the ONLY
// source of truth for settlement â€” webhook/client payloads never override it.
// The pricing snapshot (sellingPriceSnapshot/gst/creditsPurchased) is frozen at
// creation; settlement must never recalculate from live settings.
model PaymentOrder {
  id                   Int       @id @default(autoincrement())
  orderId              String    @unique // our merchant order id (PGO-â€¦)
  provider             String    @default("CASHFREE_PG")
  purpose              String    @default("VERIFICATION_CREDIT_RECHARGE")
  cfOrderId            String?
  paymentSessionId     String?   @db.Text
  companyId            Int
  branchId             Int?
  workspaceId          Int?
  workspaceKind        String?
  userId               Int?
  userName             String?
  userRole             String?
  serviceType          String    @default("BANK_VERIFICATION")
  baseAmount           Float
  gstEnabled           Boolean   @default(false)
  gstPercent           Float     @default(0)
  gstAmount            Float     @default(0)
  totalAmount          Float
  currency             String    @default("INR")
  sellingPriceSnapshot Float // per-credit selling price at order creation
  providerCostSnapshot Float     @default(0) // internal margin input â€” never sent to tenants
  creditsPurchased     Int
  packageId            Int?
  packageName          String?
  status               String    @default("CREATED") // CREATED / ACTIVE / PAID / FAILED / CANCELLED / EXPIRED / USER_DROPPED / REFUNDED / FLAGGED
  settlementStatus     String    @default("PENDING") // PENDING / AWAITING_APPROVAL / CREDITED / REJECTED
  flagReason           String?   @db.Text
  cfPaymentId          String?
  paymentMethod        String?
  bankReference        String?
  paymentTime          DateTime?
  creditedAt           DateTime?
  creditLedgerTxId     String?
  invoiceId            Int?
  approvedBy           String?
  approvedAt           DateTime?
  rawOrderResponse     Json?
  rawPaymentResponse   Json?
  failureReason        String?   @db.Text
  notes                String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([status, settlementStatus])
  @@index([cfOrderId])
  @@index([createdAt])
  @@map("payment_orders")
}

// Every webhook delivery, valid or not â€” the system of record for gateway
// callbacks (AuditService intentionally drops writes with no authenticated
// user, which a webhook never has). eventKey is the dedupe constraint.
model PaymentWebhookEvent {
  id               Int       @id @default(autoincrement())
  provider         String    @default("CASHFREE_PG")
  eventKey         String    @unique // idempotency key header or payload hash
  eventType        String?
  orderId          String?
  cfPaymentId      String?
  signatureValid   Boolean   @default(false)
  processed        Boolean   @default(false)
  processedAt      DateTime?
  processingResult String?   @db.Text
  rawPayload       Json?
  receivedAt       DateTime  @default(now())

  @@index([orderId])
  @@index([receivedAt])
  @@map("payment_webhook_events")
}

// A gateway-reported refund NEVER auto-removes credits (they may be spent).
// It creates this record, flags the order, notifies Super Admin â€” who decides
// whether to deduct credits manually (creditsAdjusted trail).
model PaymentRefund {
  id              Int       @id @default(autoincrement())
  orderId         String
  cfRefundId      String?   @unique
  companyId       Int
  amount          Float
  status          String    @default("PENDING")
  reason          String?   @db.Text
  creditsAdjusted Boolean   @default(false)
  adjustedBy      String?
  adjustedAt      DateTime?
  rawPayload      Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orderId])
  @@index([companyId])
  @@map("payment_refunds")
}

// Super-Admin-only pricing configuration (single GLOBAL row). providerCost is
// internal-only: it exists for margin reporting and must never reach a tenant
// response â€” company users see only "amount â†’ credits".
model VerificationRechargeSettings {
  id                    Int      @id @default(autoincrement())
  scope                 String   @unique @default("GLOBAL")
  enableOnlineRecharge  Boolean  @default(false)
  sellingPricePerCredit Float    @default(4.0)
  providerCostPerCredit Float    @default(2.5)
  minRechargeAmount     Float    @default(500)
  maxRechargeAmount     Float    @default(100000)
  gstEnabled            Boolean  @default(false)
  gstPercent            Float    @default(18)
  currency              String   @default("INR")
  autoCreditAllocation  Boolean  @default(true) // false = Super Admin approves each settlement
  roundOffPolicy        String   @default("FLOOR") // FLOOR / ROUND
  updatedBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("verification_recharge_settings")
}

// Quick-pick recharge packages. Credits are always computed from the CURRENT
// selling price at quote/order time â€” a package stores only the amount, so a
// price change updates every package consistently.
model VerificationRechargePackage {
  id          Int      @id @default(autoincrement())
  name        String
  amount      Float
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("verification_recharge_packages")
}

// Recharge tax invoice â€” created AFTER the settlement commit (an invoice
// failure must never roll back credits; regenerate instead). orderId is unique:
// one settled order can never produce two invoices.
model VerificationRechargeInvoice {
  id               Int       @id @default(autoincrement())
  invoiceNo        String    @unique // VCR-YYYY-0001 (credits) / ESP-YYYY-0001 (slots)
  orderId          String    @unique
  // Which paid product this invoice bills â€” drives the line-item label and
  // number prefix. The table serves all self-service purchases.
  purpose          String    @default("VERIFICATION_CREDIT_RECHARGE")
  companyId        Int
  companyName      String?
  companyEmail     String?
  billingAddress   String?   @db.Text
  gstin            String?
  creditsPurchased Int
  baseAmount       Float
  gstPercent       Float     @default(0)
  gstAmount        Float     @default(0)
  cgst             Float     @default(0)
  sgst             Float     @default(0)
  igst             Float     @default(0)
  interState       Boolean   @default(false)
  totalAmount      Float
  currency         String    @default("INR")
  cfPaymentId      String?
  paymentMethod    String?
  paymentDate      DateTime?
  status           String    @default("Paid")
  createdBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([companyId])
  @@map("verification_recharge_invoices")
}

// Lightweight tenant verification settings for mode and provider selection.
model VerificationSettings {
  id                            Int      @id @default(autoincrement())
  companyId                     Int      @unique
  verificationMode              String   @default("Manual") // Manual / API
  provider                      String   @default("ZeniaHR Verification Gateway")
  status                        String   @default("Connected") // Connected / Disconnected / Suspended
  costPerVerification           Int      @default(1)
  // Â§12 â€” when on, payroll salary transfer requires a VERIFIED bank account.
  // Off by default: turning it on is a deliberate tenant policy decision, never
  // something a module upgrade imposes on existing payroll runs.
  requireVerifiedBankForPayroll Boolean  @default(false)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@map("verification_settings")
}

// â”€â”€ White Label & Custom Domain (Beta) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// One domain â†” one company (both unique). Status machine:
// PENDING_DNS â†’ DNS_VERIFIED â†’ SSL_PENDING â†’ SSL_ISSUED â†’ ACTIVE, plus
// FAILED / DISABLED. Never hardcode mappings â€” this table is the router.
model DomainMapping {
  id                 Int       @id @default(autoincrement())
  uuid               String?   @unique // stable public identifier
  companyId          Int       @unique
  domain             String    @unique // lowercased FQDN, e.g. hr.company.com
  subdomain          String? // first label, e.g. "hr"
  status             String    @default("PENDING_DNS")
  sslStatus          String    @default("NONE") // NONE / PENDING / ISSUED / RENEWAL_FAILED
  sslProvider        String? // certbot / manual / mock (frozen at issue time)
  healthStatus       String    @default("UNKNOWN") // UNKNOWN / HEALTHY / DEGRADED / DOWN
  healthDetail       String?   @db.Text // JSON of the last health probe
  dnsType            String    @default("CNAME") // CNAME / A
  dnsTarget          String // what the customer must point at
  dnsProvider        String? // customer-declared provider (informational)
  cnameHost          String? // frozen instruction snapshot
  cnameValue         String?
  txtHost            String?
  txtValue           String?
  verificationMethod String    @default("DNS")
  verifyToken        String // TXT token (_zenia-verify) for ownership proof
  dnsCheckedAt       DateTime?
  dnsVerifiedAt      DateTime?
  sslIssuedAt        DateTime?
  sslExpiresAt       DateTime?
  activatedAt        DateTime?
  lastError          String?   @db.Text
  failCount          Int       @default(0)
  disabledBy         String?
  disabledAt         DateTime?
  createdBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@map("domain_mappings")
}

model DocumentTemplate {
  id              Int      @id @default(autoincrement())
  companyId       Int
  branchId        Int?
  name            String
  type            String
  status          String   @default("Draft")
  designType      String   @default("HTML")
  content         String?  @db.LongText
  backgroundImage String?  @db.LongText
  version         Int      @default(1)
  isGlobal        Boolean  @default(false)
  description     String?  @db.Text
  workflowStatus  String   @default("Draft")
  language        String   @default("en")
  parentTemplateId Int?
  createdBy       Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  versions        TemplateVersion[]
  assignments     TemplateAssignment[]
  usageLogs       TemplateUsageLog[]
  approvals       TemplateApproval[]
  schedules       DocumentSchedule[]

