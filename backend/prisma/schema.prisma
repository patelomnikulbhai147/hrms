model DocumentApprovalWorkflow {
  id           Int      @id @default(autoincrement())
  documentId   Int
  companyId    Int
  level        Int      @default(1)
  approverRole String
  approverId   Int?
  status       String   @default("Pending") // Pending, Approved, Rejected
  comments     String?  @db.Text
  signatureUrl String?  @db.LongText
  actionAt     DateTime?
  createdAt    DateTime @default(now())
}

model DocumentRequest {
  id            Int      @id @default(autoincrement())
  companyId     Int
  requesterType String   // Client, Employee
  requesterId   Int
  documentType  String
  status        String   @default("Pending") // Pending, Approved, Generated
  reason        String?  @db.Text
  generatedDocId Int?    
  createdAt     DateTime @default(now())
}

model DocumentAuditLog {
  id          Int      @id @default(autoincrement())
  companyId   Int
  documentId  Int?
  action      String   // View, Download, Print, Share, Approve
  performedBy String   // e.g., "PortalUser:12", "User:5"
  ipAddress   String?
  details     Json?
  createdAt   DateTime @default(now())
}

// --- SPRINT 1: Operations & Assets ---

model Vendor {
  id              Int       @id @default(autoincrement())
  companyId       Int
  name            String
  contactName     String?
  email           String?
  phone           String?
  serviceType     String?
  status          String    @default("Active")
  rating          Float     @default(0.0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  documents       VendorDocument[]
  invoices        VendorInvoice[]
  @@index([companyId])
}

model VendorDocument {
  id         Int      @id @default(autoincrement())
  vendorId   Int
  name       String
  fileUrl    String   @db.LongText
  createdAt  DateTime @default(now())
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model VendorInvoice {
  id         Int      @id @default(autoincrement())
  vendorId   Int
  amount     Float
  status     String   @default("Pending")
  dueDate    DateTime?
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model Asset {
  id              Int       @id @default(autoincrement())
  companyId       Int
  assetCode       String    @unique
  name            String
  category        String
  status          String    @default("Available") // Available, Allocated, Maintenance, Disposed
  purchaseDate    DateTime?
  warrantyExpiry  DateTime?
  value           Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  allocations     AssetAllocation[]
  @@index([companyId])
}

model AssetAllocation {
  id          Int       @id @default(autoincrement())
  assetId     Int
  employeeId  Int
  allocatedAt DateTime  @default(now())
  returnedAt  DateTime?
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model Visitor {
  id          Int       @id @default(autoincrement())
  companyId   Int
  name        String
  phone       String
  purpose     String
  hostId      Int?      // Employee ID
  status      String    @default("Pending") // Pending, Approved, Entered, Exited
  expectedAt  DateTime?
  enteredAt   DateTime?
  exitedAt    DateTime?
  qrCodeToken String?   @unique
  createdAt   DateTime  @default(now())
  @@index([companyId])
}

model Facility {
  id          Int       @id @default(autoincrement())
  companyId   Int
  name        String
  type        String    // MeetingRoom, Vehicle, Equipment
  capacity    Int?
  status      String    @default("Active")
  bookings    FacilityBooking[]
  @@index([companyId])
}

model FacilityBooking {
  id          Int       @id @default(autoincrement())
  facilityId  Int
  employeeId  Int
  startTime   DateTime
  endTime     DateTime
  purpose     String?
  status      String    @default("Approved")
  facility    Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
}

// --- SPRINT 2: Employee Experience & Learning ---

model PerformanceGoal {
  id          Int      @id @default(autoincrement())
  companyId   Int
  employeeId  Int
  title       String
  description String?  @db.Text
  type        String   @default("KPI") // KPI, OKR
  target      String?
  progress    Int      @default(0)
  status      String   @default("Active")
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([companyId])
}

model PerformanceReview {
  id              Int      @id @default(autoincrement())
  companyId       Int
  employeeId      Int
  reviewerId      Int?
  reviewPeriod    String   // e.g. "Q1 2026", "Annual 2026"
  selfRating      Float?
  selfComment     String?  @db.Text
  managerRating   Float?
  managerComment  String?  @db.Text
  status          String   @default("Pending") // Pending Self, Pending Manager, Completed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([companyId])
}

model Course {
  id          Int      @id @default(autoincrement())
  companyId   Int
  title       String
  description String?  @db.Text
  category    String?
  isMandatory Boolean  @default(false)
  status      String   @default("Draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  modules     CourseModule[]
  progress    CourseProgress[]
  @@index([companyId])
}

model CourseModule {
  id          Int      @id @default(autoincrement())
  courseId    Int
  title       String
  type        String   // Video, PDF, Quiz
  contentUrl  String?  @db.LongText
  order       Int      @default(0)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseProgress {
  id          Int      @id @default(autoincrement())
  courseId    Int
  employeeId  Int
  progress    Int      @default(0) // percentage
  status      String   @default("Not Started") // Not Started, In Progress, Completed
  completedAt DateTime?
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model KnowledgeCategory {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String
  description String?
  articles    KnowledgeArticle[]
  @@index([companyId])
}

model KnowledgeArticle {
  id          Int      @id @default(autoincrement())
  categoryId  Int
  title       String
  content     String   @db.LongText
  authorId    Int?
  status      String   @default("Published")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    KnowledgeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model SocialPost {
  id          Int      @id @default(autoincrement())
  companyId   Int
  authorId    Int
  content     String   @db.LongText
  type        String   @default("Post") // Post, Announcement, Poll, Recognition
  likesCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([companyId])
}

model AiChatHistory {
  id          Int      @id @default(autoincrement())
  companyId   Int
  employeeId  Int
  message     String   @db.Text
  response    String   @db.Text
  createdAt   DateTime @default(now())
  @@index([companyId])
}

// --- SPRINT 3: Recruitment, BI, & Workflow ---

model JobPosting {
  id              Int      @id @default(autoincrement())
  companyId       Int
  title           String
  department      String?
  location        String?
  type            String   @default("Full-Time") // Full-Time, Part-Time, Contract
  description     String   @db.LongText
  requirements    String?  @db.LongText
  status          String   @default("Open") // Draft, Open, Closed, On-Hold
  vacancies       Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  candidates      Candidate[]
  @@index([companyId])
}

model Candidate {
  id              Int      @id @default(autoincrement())
  jobId           Int
  companyId       Int
  firstName       String
  lastName        String
  email           String
  phone           String?
  resumeUrl       String?  @db.LongText
  skills          String?  @db.Text
  status          String   @default("Applied") // Applied, Screening, Interview, Offered, Hired, Rejected
  rating          Float    @default(0.0)
  aiMatchScore    Int?     // Percentage match from AI parsing
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  job             JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
  interviews      Interview[]
  @@index([companyId])
}

model Interview {
  id              Int      @id @default(autoincrement())
  candidateId     Int
  panelId         Int?     // Employee ID
  scheduledAt     DateTime
  status          String   @default("Scheduled") // Scheduled, Completed, Cancelled
  feedback        String?  @db.Text
  rating          Float?
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model Workflow {
  id              Int      @id @default(autoincrement())
  companyId       Int
  name            String
  triggerEvent    String   // e.g. "OnEmployeeOnboard", "OnLeaveRequest"
  status          String   @default("Active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  actions         WorkflowAction[]
  @@index([companyId])
}

model WorkflowAction {
  id              Int      @id @default(autoincrement())
  workflowId      Int
  type            String   // Email, SMS, Webhook, Task
  config          Json     // Target endpoints, payload templates
  order           Int      @default(0)
  workflow        Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model IntegrationConnection {
  id              Int      @id @default(autoincrement())
  companyId       Int
  provider        String   // Google Workspace, Slack, SAP
  status          String   @default("Disconnected") // Connected, Disconnected, Error
  credentials     Json?    // Encrypted OAuth tokens / API keys
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([companyId])
}

model NotificationTemplate {
  id              Int      @id @default(autoincrement())
  companyId       Int
  name            String
  channel         String   // Email, SMS, WhatsApp, Push
  subject         String?
  body            String   @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([companyId])
}

// --- PHASE 6: SaaS Enterprise & Security ---

model SaaSMarketplaceItem {
  id           Int      @id @default(autoincrement())
  name         String
  type         String   // Credit, Storage, Addon, Branch, AppStorePlugin
  price        Float
  billingCycle String   // Monthly, Yearly, One-time
  description  String?  @db.Text
  createdAt    DateTime @default(now())
}

model ApiCredential {
  id          Int      @id @default(autoincrement())
  companyId   Int
  appName     String
  apiKey      String   @unique
  apiSecret   String
  rateLimit   Int      @default(1000)
  createdAt   DateTime @default(now())
  @@index([companyId])
}

model WebhookSubscription {
  id          Int      @id @default(autoincrement())
  companyId   Int
  event       String
  targetUrl   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  @@index([companyId])
}

model SystemAuditLog {
  id          Int      @id @default(autoincrement())
  companyId   Int
  userId      Int?
  action      String
  ipAddress   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  @@index([companyId])
}

model SecurityPolicy {
  id                Int      @id @default(autoincrement())
  companyId         Int      @unique
  require2FA        Boolean  @default(false)
  ssoProvider       String?
  ipWhitelist       String?  @db.Text
  sessionTimeoutMin Int      @default(60)
  updatedAt         DateTime @updatedAt
}

model StorageQuota {
  id                Int      @id @default(autoincrement())
  companyId         Int      @unique
  maxStorageBytes   BigInt
  usedStorageBytes  BigInt   @default(0)
  updatedAt         DateTime @updatedAt
}
